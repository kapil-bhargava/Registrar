@* Views/Student/Dashboard.cshtml *@
@model Regis.Models.StudentProfileModel
@{
    ViewData["Title"] = "StudentDashboard";
    ViewData["PageTitle"] = "Dashboard";
    ViewData["ActiveMenu"] = "Dashboard";
    Layout = "~/Views/Shared/_mainLayout.cshtml";
}

<style>
    :root {
    --navy-900: #12335e;
    --navy-800: #17417a;
    --navy-600: #2f6fc9;
    --gold: #c9a545;
    --gold-soft: #f3e6bf;
    --paper: #f6f7fb;
    --ink: #1b2434;
    --muted: #8791a3;
    --line: #e4e8f1;
    --green: #1f8a5b;
    --green-bg: #e6f4ec;
    --red: #b3382c;
    --red-bg: #fdeeee;
    --blue: #2058c9;
    --blue-bg: #eaf1ff;
}

/* ---------- Hero header ---------- */
.hero {
    position: relative;
    border-radius: 12px;
    padding: 16px 22px;
    margin-bottom: 18px;
    background: linear-gradient(120deg, var(--navy-900) 0%, var(--navy-600) 100%);
    overflow: hidden;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px;
}

    .hero::before {
        content: "";
        position: absolute;
        top: -60px;
        right: -60px;
        width: 220px;
        height: 220px;
        border-radius: 50%;
        background: radial-gradient(circle, rgba(255,255,255,0.14) 0%, rgba(255,255,255,0) 70%);
    }

.hero-left {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    gap: 14px;
}

.hero-avatar {
    width: 40px;
    height: 40px;
    border-radius: 10px;
    background: linear-gradient(145deg, var(--gold), #b48f3a);
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 800;
    font-size: 1rem;
    color: var(--navy-900);
    flex-shrink: 0;
    box-shadow: 0 4px 10px rgba(0,0,0,0.15);
}

.hero h2 {
    margin: 0;
    font-size: 1.1rem;
    font-weight: 700;
    color: #fff;
    letter-spacing: 0.01em;
}

.hero-sub {
    margin-top: 2px;
    color: #dbe6f7;
    font-size: 0.78rem;
    display: flex;
    align-items: center;
    gap: 8px;
}

    .hero-sub .dot {
        width: 4px;
        height: 4px;
        border-radius: 50%;
        background: #a9c1e6;
        display: inline-block;
    }

.app-no-chip {
    position: relative;
    z-index: 1;
    background: rgba(255,255,255,0.15);
    border: 1px solid rgba(255,255,255,0.3);
    border-radius: 20px;
    padding: 6px 14px;
    font-size: 0.72rem;
    font-weight: 600;
    color: #fff;
    letter-spacing: 0.02em;
}

/* ---------- Stat cards ---------- */
.stat-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 14px;
    margin-bottom: 24px;
}

.stat-card {
    position: relative;
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 14px;
    padding: 18px 18px 16px;
    overflow: hidden;
    transition: box-shadow .18s ease, transform .18s ease;
}

    .stat-card:hover {
        box-shadow: 0 8px 20px rgba(15,36,71,0.08);
        transform: translateY(-2px);
    }

.stat-icon {
    width: 34px;
    height: 34px;
    border-radius: 9px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1rem;
    margin-bottom: 12px;
}

.stat-icon.stage { background: var(--gold-soft); }
.stat-icon.docs { background: var(--green-bg); }
.stat-icon.fee { background: var(--blue-bg); }
.stat-icon.sem { background: #f1ecff; }

.stat-label {
    font-size: 0.66rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--muted);
    font-weight: 700;
    margin-bottom: 6px;
}

.stat-value {
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--navy-900);
}

/* ---------- Info cards ---------- */
.card {
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 14px;
    padding: 22px 26px 24px;
    margin-bottom: 20px;
}

.card-head {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0 0 18px;
    padding-bottom: 14px;
    border-bottom: 1px solid var(--line);
}

    .card-head .ic {
        width: 30px;
        height: 30px;
        border-radius: 8px;
        background: var(--navy-800);
        color: var(--gold-soft);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.85rem;
    }

    .card-head h3 {
        margin: 0;
        font-size: 0.8rem;
        color: var(--navy-800);
        text-transform: uppercase;
        letter-spacing: 0.06em;
        font-weight: 800;
    }

.grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 18px 30px;
}

.row {
    display: flex;
    flex-direction: column;
    padding: 10px 14px;
    background: var(--paper);
    border-radius: 10px;
    border-left: 3px solid var(--gold);
}

    .row label {
        font-size: 0.68rem;
        color: var(--muted);
        text-transform: uppercase;
        letter-spacing: 0.04em;
        margin-bottom: 4px;
        font-weight: 600;
    }

    .row span {
        font-size: 0.94rem;
        font-weight: 600;
        color: var(--ink);
    }

.badge {
    display: inline-block;
    padding: 4px 12px;
    border-radius: 20px;
    font-size: 0.75rem;
    font-weight: 700;
}

    .badge.ok { background: var(--green-bg); color: var(--green); }
    .badge.pending { background: var(--red-bg); color: var(--red); }

@@media (max-width: 900px) {
    .stat-grid { grid-template-columns: 1fr 1fr; }
}

@@media (max-width: 700px) {
    .stat-grid, .grid { grid-template-columns: 1fr; }
    .hero { padding: 24px 20px; }
}
</style>

@if (Model == null)
{
    <div class="card">
        <p style="color:var(--muted);font-size:0.88rem;">Unable to load your profile. Please contact the Registrar's office.</p>
    </div>
}
else
{
    <div class="hero">
        <div class="hero-left">
            <div class="hero-avatar">@(string.IsNullOrEmpty(Model.FullName) ? "S" : Model.FullName.Trim()[0].ToString().ToUpper())</div>
            <div>
                <h2>Welcome, @Model.FullName</h2>
                <div class="hero-sub">
                    <span>@Model.CourseName</span>
                    @if (!string.IsNullOrEmpty(Model.Branch))
                    {
                        <span class="dot"></span><span>@Model.Branch</span>
                    }
                </div>
            </div>
        </div>
        <div class="app-no-chip">Application No: @Model.ApplicationNo</div>
    </div>

    <div class="stat-grid">
        <div class="stat-card">
            <div class="stat-icon stage">🎓</div>
            <div class="stat-label">Current Stage</div>
            <div class="stat-value">@Model.Stage</div>
        </div>
        <div class="stat-card">
            <div class="stat-icon docs">📄</div>
            <div class="stat-label">Documents</div>
            <span class="badge @(Model.DocVerified ? "ok" : "pending")">@(Model.DocVerified ? "Verified" : Model.SubmittedDocCount + "/" + Model.RequiredDocCount)</span>
        </div>
        <div class="stat-card">
            <div class="stat-icon fee">💳</div>
            <div class="stat-label">Fee Status</div>
            <span class="badge @(Model.FeePaid ? "ok" : "pending")">@(Model.FeePaid ? "Paid" : "Pending")</span>
        </div>
        <div class="stat-card">
            <div class="stat-icon sem">📚</div>
            <div class="stat-label">Semester</div>
            <div class="stat-value">@(Model.Semester ?? "-")</div>
        </div>
    </div>

    <div class="card">
        <div class="card-head">
            <div class="ic">📋</div>
            <h3>Admission Summary</h3>
        </div>
        <div class="grid">
            <div class="row"><label>Course</label><span>@Model.CourseName</span></div>
            <div class="row"><label>Branch</label><span>@(Model.Branch ?? "-")</span></div>
            <div class="row"><label>Category</label><span>@(Model.CategoryName ?? "-")</span></div>
            <div class="row"><label>Registered On</label><span>@(Model.RegisteredOn?.ToString("dd MMM yyyy") ?? "-")</span></div>
            <div class="row"><label>Email</label><span>@(Model.Email ?? "-")</span></div>
            <div class="row"><label>Phone</label><span>@(Model.Phone ?? "-")</span></div>
        </div>
    </div>
}
