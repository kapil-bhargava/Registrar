@model List<Regis.Models.BranchMasterModel>
@using Regis.Models

@{
    ViewBag.Title = "BranchMaster";
    Layout = "~/Views/Shared/_mainLayout.cshtml";

    var departments = ViewBag.Departments as List<DepartmentMasterModel>
        ?? new List<DepartmentMasterModel>();

    var programs = ViewBag.Programs as List<ProgramMasterModel>
        ?? new List<ProgramMasterModel>();

    var courses = ViewBag.Courses as List<CourseMasterModel>
        ?? new List<CourseMasterModel>();
}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<link href="~/Content/CSS/academicSession.css" rel="stylesheet" />

<style>
    /* ---- Local polish for Branch Master list (does not touch academicSession.css) ---- */
    .br-toolbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 12px;
        margin-bottom: 16px;
    }

    .br-filter-pills {
        display: flex;
        gap: 8px;
    }

        .br-filter-pills button {
            border: 1px solid #d9dee3;
            background: #fff;
            color: #64748b;
            font-family: 'Inter', sans-serif;
            font-size: 13px;
            font-weight: 500;
            padding: 7px 14px;
            border-radius: 20px;
            cursor: pointer;
            transition: all 0.15s ease;
        }

            .br-filter-pills button:hover {
                border-color: #0b5ed7;
                color: #0b5ed7;
            }

            .br-filter-pills button.active {
                background: #0b5ed7;
                border-color: #0b5ed7;
                color: #fff;
            }

    .br-result-count {
        font-family: 'Inter', sans-serif;
        font-size: 13px;
        color: #8a8f98;
        margin-bottom: 10px;
    }

    .as-table-wrapper {
        max-height: 640px;
        overflow-y: auto;
    }

        .as-table-wrapper table thead th {
            position: sticky;
            top: 0;
            background: #f6f7fa;
            z-index: 2;
            box-shadow: 0 1px 0 #e5e8ec;
        }

    .as-table.as-list-table tbody tr:hover {
        background: #f9fbff;
    }

    .br-badge-ug {
        background: #eaf3ff;
        color: #0b5ed7;
        border-radius: 12px;
        padding: 3px 10px;
        font-size: 12px;
        font-weight: 600;
        white-space: nowrap;
    }

    .br-badge-pg {
        background: #fff3e0;
        color: #b8720b;
        border-radius: 12px;
        padding: 3px 10px;
        font-size: 12px;
        font-weight: 600;
        white-space: nowrap;
    }

    .br-course-text {
        max-width: 220px;
        display: inline-block;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        vertical-align: middle;
    }
</style>

<div class="as-wrap">

    <!-- ================= LIST PAGE ================= -->

    <div class="as-card" id="brListWrap">

        <div class="as-list-head">

            <div>
                <h2>
                    <i class="fas fa-code-branch"></i>
                    Branch Master
                </h2>

                <p>
                    Manage academic branches and map them to departments and programs.
                </p>
            </div>

            <button class="as-btn as-btn-primary"
                    onclick="brShowForm()">

                <i class="fas fa-plus-circle"></i>
                Add New Branch

            </button>

        </div>


        <!-- QUICK STATS -->

        <div class="as-quick-stats">

            <div class="as-stat-card">

                <div class="as-stat-icon">
                    <i class="fas fa-code-branch"></i>
                </div>

                <div class="as-stat-info">

                    <span class="as-stat-number">
                        @Model.Count
                    </span>

                    <span class="as-stat-label">
                        Total Branches
                    </span>

                </div>

            </div>


            <div class="as-stat-card active">

                <div class="as-stat-icon">
                    <i class="fas fa-check-circle"></i>
                </div>

                <div class="as-stat-info">

                    <span class="as-stat-number">
                        @Model.Count(b => b.IsActive)
                    </span>

                    <span class="as-stat-label">
                        Active Branches
                    </span>

                </div>

            </div>


            <div class="as-stat-card">

                <div class="as-stat-icon">
                    <i class="fas fa-pause-circle"></i>
                </div>

                <div class="as-stat-info">

                    <span class="as-stat-number">
                        @Model.Count(b => !b.IsActive)
                    </span>

                    <span class="as-stat-label">
                        Inactive Branches
                    </span>

                </div>

            </div>

        </div>

        <!-- ===== TOOLBAR: Search + Status Filter ===== -->
        <div class="br-toolbar">

            <input type="text" id="brSearchBox" class="as-search-input"
                   placeholder="Search by Branch Code or Branch Name..."
                   onkeyup="brSearchTable()"
                   style="flex:1; min-width:260px; max-width:340px; padding:10px 14px; border:1px solid #d9dee3; border-radius:8px; font-family:'Inter',sans-serif; font-size:14px;">

            <div class="br-filter-pills" id="brFilterPills">
                <button type="button" class="active" data-filter="all" onclick="brFilterStatus('all', this)">All</button>
                <button type="button" data-filter="active" onclick="brFilterStatus('active', this)">Active</button>
                <button type="button" data-filter="inactive" onclick="brFilterStatus('inactive', this)">Inactive</button>
            </div>

        </div>

        <div class="br-result-count" id="brResultCount">
            Showing @Model.Count of @Model.Count branches
        </div>


        <!-- TABLE -->

        <div class="as-table-wrapper">

            <table class="as-table as-list-table">

                <thead>

                    <tr>
                        <th>Branch Code</th>
                        <th>Branch Name</th>
                        <th>Department</th>
                        <th>Program</th>
                        <th>Course</th>
                        <th>Campus</th>
                        <th>Intake Capacity</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>

                </thead>


                <tbody id="brTableBody">

                    @foreach (var b in Model)
                    {
                        var isPg = (b.ProgramName ?? "").ToLower().Contains("post");
                        <tr data-status="@(b.IsActive ? "active" : "inactive")">

                            <td>
                                <strong>
                                    @b.BranchCode
                                </strong>
                            </td>

                            <td>
                                @b.BranchName
                            </td>

                            <td>
                                @b.DepartmentName
                            </td>

                            <td>
                                <span class="@(isPg ? "br-badge-pg" : "br-badge-ug")">
                                    @b.ProgramName
                                </span>
                            </td>

                            <td>
                                <span class="br-course-text" title="@b.CourseName">
                                    @(string.IsNullOrEmpty(b.CourseName) ? "-" : b.CourseName)
                                </span>
                            </td>

                            <td>
                                @b.CampusName
                            </td>

                            <td>
                                @b.IntakeCapacity
                            </td>

                            <td>

                                @if (b.IsActive)
                                {
                                    <span class="as-pill as-pill-active">
                                        <i class="fas fa-circle"></i>
                                        Active
                                    </span>
                                }
                                else
                                {
                                    <span class="as-pill as-pill-archived">
                                        <i class="fas fa-circle"></i>
                                        Inactive
                                    </span>
                                }

                            </td>

                            <td>

                                <button type="button"
                                        class="as-mini-btn"
                                        title="Edit"
                                        onclick="brShowForm(this)"
                                        data-id="@b.BranchId"
                                        data-code="@b.BranchCode"
                                        data-name="@b.BranchName"
                                        data-departmentid="@b.DepartmentId"
                                        data-programid="@b.ProgramId"
                                        data-courseid="@b.CourseId"
                                        data-campus="@b.CampusName"
                                        data-intake="@b.IntakeCapacity"
                                        data-active="@b.IsActive.ToString().ToLower()">

                                    <i class="fas fa-edit"></i>

                                </button>


                                <a class="as-mini-btn"
                                   title="Delete"
                                   href="@Url.Action("DeleteBranchMaster", "Master", new { id = b.BranchId })"
                                   onclick="return confirm('Delete this branch?');">

                                    <i class="fas fa-trash-alt"></i>

                                </a>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

            <p id="brNoResults" style="display:none; text-align:center; padding:16px; color:#8a8f98;">No matching branches found.</p>

        </div>


        <div class="as-legend">

            <span>
                <span class="as-legend-dot active"></span>
                Active
            </span>

            <span>
                <span class="as-legend-dot archived"></span>
                Inactive
            </span>

        </div>

    </div>


    <!-- ================= ADD / EDIT FORM ================= -->

    @using (Html.BeginForm("BranchMaster", "Master", FormMethod.Post, new { id = "brForm", onsubmit = "return brValidateForm()" }))
    {

        <div class="as-card as-wizard-card"
             id="brFormWrap"
             style="display:none;">

            <div class="as-back-row">

                <button type="button"
                        class="as-back-link"
                        onclick="brShowList()">

                    <i class="fas fa-arrow-left"></i>
                    Back to Branches List

                </button>

            </div>


            <div class="as-body">

                <div class="as-page active">

                    <div class="as-head">

                        <div class="as-icon">

                            <i class="fas fa-code-branch"></i>

                        </div>

                        <div>

                            <h2 id="brFormTitle">
                                Add Branch
                            </h2>

                            <p>
                                Define a new academic branch under a department and program.
                            </p>

                        </div>

                    </div>


                    <div class="as-section-title">

                        <i class="fas fa-info-circle"></i>
                        Basic Information

                    </div>


                    <input type="hidden"
                           id="branchId"
                           name="BranchId"
                           value="0" />


                    <div class="as-grid">


                        <!-- BRANCH CODE -->

                        <div class="as-field">

                            <label>
                                Branch Code
                                <span class="req">*</span>
                            </label>

                            <input type="text"
                                   id="branchCode"
                                   name="BranchCode"
                                   placeholder="e.g. CSE-AI">

                        </div>


                        <!-- BRANCH NAME -->

                        <div class="as-field">

                            <label>
                                Branch Name
                                <span class="req">*</span>
                            </label>

                            <input type="text"
                                   id="branchName"
                                   name="BranchName"
                                   placeholder="e.g. Computer Science & Engineering - AI">

                        </div>


                        <!-- DEPARTMENT -->

                        <div class="as-field">

                            <label>
                                Department
                                <span class="req">*</span>
                            </label>

                            <select id="departmentId"
                                    name="DepartmentId">

                                <option value="">
                                    -- Select Department --
                                </option>

                                @foreach (var d in departments)
                                {
                                    <option value="@d.DepartmentId">
                                        @d.DepartmentName
                                    </option>
                                }

                            </select>

                            <span class="as-hint">
                                Managed from Department Master
                            </span>

                        </div>


                        <!-- PROGRAM -->

                        <div class="as-field">

                            <label>
                                Program
                                <span class="req">*</span>
                            </label>

                            <select id="programId"
                                    name="ProgramId">

                                <option value="">
                                    -- Select Program --
                                </option>

                                @foreach (var p in programs)
                                {
                                    <option value="@p.ProgramId">
                                        @p.ProgramName
                                    </option>
                                }

                            </select>

                            <span class="as-hint">
                                Managed from Program Master
                            </span>

                        </div>


                        <!-- COURSE -->

                        <div class="as-field">

                            <label>
                                Course
                                <span class="req">*</span>
                            </label>

                            <select id="courseId"
                                    name="CourseId">

                                <option value="">
                                    -- Select Course --
                                </option>

                                @foreach (var c in courses)
                                {
                                    <option value="@c.CourseId">
                                        @c.CourseName
                                    </option>
                                }

                            </select>

                            <span class="as-hint">
                                Managed from Course Master
                            </span>

                        </div>


                        <!-- CAMPUS -->

                        <div class="as-field">

                            <label>
                                Campus Name
                            </label>

                            <input type="text"
                                   id="campusName"
                                   name="CampusName"
                                   placeholder="e.g. Main Campus">

                        </div>


                        <!-- INTAKE -->

                        <div class="as-field">

                            <label>
                                Intake Capacity
                            </label>

                            <input type="number"
                                   id="intakeCapacity"
                                   name="IntakeCapacity"
                                   placeholder="e.g. 120"
                                   min="0">

                        </div>


                        <!-- STATUS -->

                        <div class="as-field">

                            <label>
                                Status
                            </label>

                            <select id="branchStatus"
                                    name="IsActive">

                                <option value="true">
                                    Active
                                </option>

                                <option value="false">
                                    Inactive
                                </option>

                            </select>

                        </div>

                    </div>


                    <div class="as-bar">

                        <button type="button"
                                class="as-btn as-btn-ghost"
                                onclick="brShowList()">

                            Cancel

                        </button>

                        <span></span>

                        <button type="submit"
                                class="as-btn as-btn-primary">

                            <i class="fas fa-save"></i>

                            <span id="brSubmitText">
                                Save Branch
                            </span>

                        </button>

                    </div>

                </div>

            </div>

        </div>

    }

</div>


<!-- ================= JAVASCRIPT ================= -->

<script>

    var brCurrentFilter = 'all';

    function brShowForm(btn) {

        document.getElementById('brListWrap').style.display = 'none';

        document.getElementById('brFormWrap').style.display = 'block';


        if (btn) {

            document.getElementById('brFormTitle').textContent =
                'Edit Branch';

            document.getElementById('brSubmitText').textContent =
                'Update Branch';


            document.getElementById('branchId').value =
                btn.dataset.id;

            document.getElementById('branchCode').value =
                btn.dataset.code;

            document.getElementById('branchName').value =
                btn.dataset.name;

            document.getElementById('departmentId').value =
                btn.dataset.departmentid || '';

            document.getElementById('programId').value =
                btn.dataset.programid || '';

            document.getElementById('courseId').value =
                btn.dataset.courseid || '';

            document.getElementById('campusName').value =
                btn.dataset.campus || '';

            document.getElementById('intakeCapacity').value =
                btn.dataset.intake || '';

            document.getElementById('branchStatus').value =
                btn.dataset.active;

        }
        else {

            document.getElementById('brFormTitle').textContent =
                'Add Branch';

            document.getElementById('brSubmitText').textContent =
                'Save Branch';


            document.getElementById('branchId').value = 0;

            document.getElementById('branchCode').value = '';

            document.getElementById('branchName').value = '';

            document.getElementById('departmentId').value = '';

            document.getElementById('programId').value = '';

            document.getElementById('courseId').value = '';

            document.getElementById('campusName').value = '';

            document.getElementById('intakeCapacity').value = '';

            document.getElementById('branchStatus').value = 'true';

        }


        window.scrollTo({
            top: 0,
            behavior: 'smooth'
        });

    }


    function brShowList() {

        document.getElementById('brFormWrap').style.display =
            'none';

        document.getElementById('brListWrap').style.display =
            'block';


        window.scrollTo({
            top: 0,
            behavior: 'smooth'
        });

    }


    // ===== SEARCH by Branch Code / Branch Name (works together with status filter) =====
    function brSearchTable() {
        brApplyFilters();
    }


    // ===== STATUS FILTER (All / Active / Inactive) =====
    function brFilterStatus(filter, btn) {
        brCurrentFilter = filter;

        document.querySelectorAll('#brFilterPills button').forEach(function (b) {
            b.classList.remove('active');
        });
        btn.classList.add('active');

        brApplyFilters();
    }


    // ===== Combined filter: search text + status =====
    function brApplyFilters() {
        var searchText = document.getElementById('brSearchBox').value.toLowerCase().trim();
        var rows = document.querySelectorAll('#brTableBody tr');
        var visibleCount = 0;

        rows.forEach(function (row) {
            var code = row.cells[0].textContent.toLowerCase();
            var name = row.cells[1].textContent.toLowerCase();
            var status = row.getAttribute('data-status');

            var matchesSearch = code.indexOf(searchText) > -1 || name.indexOf(searchText) > -1;
            var matchesStatus = brCurrentFilter === 'all' || status === brCurrentFilter;

            if (matchesSearch && matchesStatus) {
                row.style.display = '';
                visibleCount++;
            } else {
                row.style.display = 'none';
            }
        });

        document.getElementById('brNoResults').style.display = visibleCount === 0 ? 'block' : 'none';

        var totalCount = rows.length;
        document.getElementById('brResultCount').textContent =
            'Showing ' + visibleCount + ' of ' + totalCount + ' branches';
    }


    // ===== FORM VALIDATION (required fields) =====
    function brValidateForm() {
        var code = document.getElementById('branchCode').value.trim();
        var name = document.getElementById('branchName').value.trim();
        var departmentId = document.getElementById('departmentId').value.trim();
        var programId = document.getElementById('programId').value.trim();
        var courseId = document.getElementById('courseId').value.trim();

        if (!code || !name || !departmentId || !programId || !courseId) {
            alert('Branch Code, Branch Name, Department, Program aur Course zaroori hai. Empty form save nahi hoga.');
            return false;
        }

        return true;
    }

</script>