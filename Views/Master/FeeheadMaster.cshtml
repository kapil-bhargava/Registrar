@model List<Regis.Models.FeeHeadModel>

@{
    ViewBag.Title = "FeeheadMaster";
    Layout = "~/Views/Shared/_mainLayout.cshtml";
}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<link href="~/Content/CSS/academicSession.css" rel="stylesheet" />

<div class="as-wrap">

    <!-- ================= LIST PAGE ================= -->
    <div class="as-card" id="fhListWrap">
        <div class="as-list-head">
            <div>
                <h2><i class="fas fa-file-invoice-dollar"></i> Fee Head Master</h2>
                <p>Manage fee heads (Tuition Fee, Exam Fee, Hostel Fee, etc.) and their amounts.</p>
            </div>
            <button class="as-btn as-btn-primary" onclick="fhShowForm()">
                <i class="fas fa-plus-circle"></i> Add New Fee Head
            </button>
        </div>

        <div class="as-quick-stats">
            <div class="as-stat-card">
                <div class="as-stat-icon"><i class="fas fa-file-invoice-dollar"></i></div>
                <div class="as-stat-info">
                    <span class="as-stat-number">@Model.Count</span>
                    <span class="as-stat-label">Total Fee Heads</span>
                </div>
            </div>
            <div class="as-stat-card active">
                <div class="as-stat-icon"><i class="fas fa-check-circle"></i></div>
                <div class="as-stat-info">
                    <span class="as-stat-number">@Model.Count(f => f.IsActive)</span>
                    <span class="as-stat-label">Active Fee Heads</span>
                </div>
            </div>
            <div class="as-stat-card">
                <div class="as-stat-icon"><i class="fas fa-rupee-sign"></i></div>
                <div class="as-stat-info">
                    <span class="as-stat-number">₹@Model.Where(f => f.IsActive).Sum(f => f.Amount).ToString("N0")</span>
                    <span class="as-stat-label">Total Active Amount</span>
                </div>
            </div>
        </div>

        <div class="as-table-wrapper">
            <table class="as-table as-list-table">
                <thead>
                    <tr>
                        <th>Fee Head Code</th>
                        <th>Fee Head Name</th>
                        <th>Amount (₹)</th>
                        <th>Description</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody id="fhTableBody">
                    @foreach (var f in Model)
                    {
                        <tr>
                            <td><strong>@f.FeeHeadCode</strong></td>
                            <td>@f.FeeHeadName</td>
                            <td>₹@f.Amount.ToString("N0")</td>
                            <td>@f.Description</td>
                            <td>
                                @if (f.IsActive)
                                {
                                    <span class="as-pill as-pill-active"><i class="fas fa-circle"></i> Active</span>
                                }
                                else
                                {
                                    <span class="as-pill as-pill-archived"><i class="fas fa-circle"></i> Inactive</span>
                                }
                            </td>
                            <td>
                                <button type="button" class="as-mini-btn" title="Edit" onclick="fhShowForm(this)"
                                        data-id="@f.FeeHeadId" data-code="@f.FeeHeadCode" data-name="@f.FeeHeadName"
                                        data-amount="@f.Amount" data-desc="@f.Description" data-active="@f.IsActive.ToString().ToLower()">
                                    <i class="fas fa-edit"></i>
                                </button>
                                <a class="as-mini-btn" title="Delete"
                                   href="@Url.Action("DeleteFeeHeadMaster", "Master", new { id = f.FeeHeadId })"
                                   onclick="return confirm('Delete this fee head?');">
                                    <i class="fas fa-trash-alt"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="as-legend">
            <span><span class="as-legend-dot active"></span> Active</span>
            <span><span class="as-legend-dot archived"></span> Inactive</span>
        </div>
    </div>

    <!-- ================= ADD / EDIT FEE HEAD FORM ================= -->
    @using (Html.BeginForm("FeeheadMaster", "Master", FormMethod.Post, new { id = "feeHeadForm" }))
    {
        <div class="as-card as-wizard-card" id="fhFormWrap" style="display:none;">

            <div class="as-back-row">
                <button type="button" class="as-back-link" onclick="fhShowList()">
                    <i class="fas fa-arrow-left"></i> Back to Fee Head List
                </button>
            </div>

            <div class="as-body">
                <div class="as-page active">
                    <div class="as-head">
                        <div class="as-icon"><i class="fas fa-file-invoice-dollar"></i></div>
                        <div>
                            <h2 id="fhFormTitle">Add Fee Head</h2>
                            <p>Define a new fee head and its amount.</p>
                        </div>
                    </div>

                    <div class="as-section-title"><i class="fas fa-info-circle"></i> Basic Information</div>

                    <input type="hidden" id="feeHeadId" name="FeeHeadId" value="0" />

                    <div class="as-grid">
                        <div class="as-field">
                            <label>Fee Head Code <span class="req">*</span></label>
                            <input type="text" id="feeHeadCode" name="FeeHeadCode" placeholder="e.g. TUITION" required>
                            <span class="as-field-error" id="err-feeHeadCode"></span>
                        </div>
                        <div class="as-field">
                            <label>Fee Head Name <span class="req">*</span></label>
                            <input type="text" id="feeHeadName" name="FeeHeadName" placeholder="e.g. Tuition Fee" required>
                            <span class="as-field-error" id="err-feeHeadName"></span>
                        </div>
                        <div class="as-field">
                            <label>Amount (₹) <span class="req">*</span></label>
                            <input type="number" id="feeHeadAmount" name="Amount" step="0.01" min="0.01" placeholder="e.g. 5000" required>
                            <span class="as-field-error" id="err-feeHeadAmount"></span>
                        </div>
                        <div class="as-field">
                            <label>Status</label>
                            <select id="feeHeadStatus" name="IsActive">
                                <option value="true">Active</option>
                                <option value="false">Inactive</option>
                            </select>
                        </div>
                        <div class="as-field as-full">
                            <label>Description</label>
                            <textarea id="feeHeadDescription" name="Description" placeholder="Brief description..."></textarea>
                        </div>
                    </div>

                    <div class="as-bar">
                        <button type="button" class="as-btn as-btn-ghost" onclick="fhShowList()">Cancel</button>
                        <span></span>
                        <button type="submit" class="as-btn as-btn-primary">
                            <i class="fas fa-save"></i> <span id="fhSubmitText">Save Fee Head</span>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }

</div>

<div class="as-toast" id="fhToast">
    <i class="fas fa-check-circle"></i>
    <span id="fhToastMessage">Success!</span>
</div>

<style>
    .as-field-error {
        display: block;
        color: #b3382c;
        font-size: 0.75rem;
        margin-top: 4px;
        min-height: 14px;
    }

    .as-field input.as-invalid,
    .as-field select.as-invalid,
    .as-field textarea.as-invalid {
        border-color: #b3382c !important;
        background: #fdeeee !important;
    }
</style>

<script>
    function fhShowForm(btn) {
        document.getElementById('fhListWrap').style.display = 'none';
        document.getElementById('fhFormWrap').style.display = 'block';

        if (btn) {
            document.getElementById('fhFormTitle').textContent = 'Edit Fee Head';
            document.getElementById('fhSubmitText').textContent = 'Update Fee Head';

            document.getElementById('feeHeadId').value = btn.dataset.id;
            document.getElementById('feeHeadCode').value = btn.dataset.code;
            document.getElementById('feeHeadName').value = btn.dataset.name;
            document.getElementById('feeHeadAmount').value = btn.dataset.amount;
            document.getElementById('feeHeadDescription').value = btn.dataset.desc || '';
            document.getElementById('feeHeadStatus').value = btn.dataset.active;
        } else {
            document.getElementById('fhFormTitle').textContent = 'Add Fee Head';
            document.getElementById('fhSubmitText').textContent = 'Save Fee Head';
            document.getElementById('feeHeadId').value = 0;
            document.getElementById('feeHeadCode').value = '';
            document.getElementById('feeHeadName').value = '';
            document.getElementById('feeHeadAmount').value = '';
            document.getElementById('feeHeadDescription').value = '';
            document.getElementById('feeHeadStatus').value = 'true';
        }
        fhClearErrors();
        window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    function fhShowList() {
        document.getElementById('fhFormWrap').style.display = 'none';
        document.getElementById('fhListWrap').style.display = 'block';
        window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    function fhClearErrors() {
        ['feeHeadCode', 'feeHeadName', 'feeHeadAmount'].forEach(function (id) {
            document.getElementById(id).classList.remove('as-invalid');
            document.getElementById('err-' + id).textContent = '';
        });
    }

    // ---- Client-side validation (server-side already exists; this stops blank submits early) ----
    document.getElementById('feeHeadForm').addEventListener('submit', function (e) {
        fhClearErrors();
        var code = document.getElementById('feeHeadCode').value.trim();
        var name = document.getElementById('feeHeadName').value.trim();
        var amountRaw = document.getElementById('feeHeadAmount').value;
        var amount = parseFloat(amountRaw);
        var hasError = false;

        if (!code) {
            document.getElementById('feeHeadCode').classList.add('as-invalid');
            document.getElementById('err-feeHeadCode').textContent = 'Fee Head Code is required.';
            hasError = true;
        }
        if (!name) {
            document.getElementById('feeHeadName').classList.add('as-invalid');
            document.getElementById('err-feeHeadName').textContent = 'Fee Head Name is required.';
            hasError = true;
        }
        if (!amountRaw || isNaN(amount) || amount <= 0) {
            document.getElementById('feeHeadAmount').classList.add('as-invalid');
            document.getElementById('err-feeHeadAmount').textContent = 'Enter a valid amount greater than 0.';
            hasError = true;
        }

        if (hasError) {
            e.preventDefault();
        }
    });
</script>
