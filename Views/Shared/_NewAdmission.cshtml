@{
    // Query string me applicationId aaya to Session update kar do, warna Session me jo pehle se hai wahi use karo
    if (Request.QueryString["applicationId"] != null)
    {
        int qsAppId;
        if (int.TryParse(Request.QueryString["applicationId"], out qsAppId) && qsAppId > 0)
        {
            Session["ApplicationId"] = qsAppId;
        }
    }
    var navApplicationId = Session["ApplicationId"];
    string action = ViewContext.RouteData.Values["action"].ToString();
}
<style>
    .cp-sticky-header {
        position: sticky;
        top: 60px;
        z-index: 998;
        background: #fff;
        border-radius: 12px;
        box-shadow: 0 2px 10px rgba(20, 20, 43, 0.06);
        margin-bottom: 20px;
    }

    .cp-nav-tabs {
        display: flex;
        overflow-x: auto;
        white-space: nowrap;
        padding: 6px;
        gap: 4px;
    }

        .cp-nav-tabs::-webkit-scrollbar {
            height: 4px;
        }

        .cp-nav-tabs::-webkit-scrollbar-thumb {
            background: #e1e4ea;
            border-radius: 4px;
        }

    .cp-nav-link {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 12px 18px;
        color: #6b7280;
        text-decoration: none;
        font-weight: 600;
        font-size: 14px;
        border-radius: 8px;
        transition: color 0.15s ease, background 0.15s ease;
    }

        .cp-nav-link i {
            font-size: 13px;
            color: #9aa1b1;
            transition: color 0.15s ease;
        }

        .cp-nav-link:hover {
            color: #7a3fd8;
            background: #f6f1fc;
        }

            .cp-nav-link:hover i {
                color: #7a3fd8;
            }

        .cp-nav-link.active {
            color: #fff;
            background: linear-gradient(90deg, #6b3fd6 0%, #7a3fd8 55%, #d945a8 100%);
            box-shadow: 0 4px 10px rgba(107, 63, 214, 0.28);
        }

            .cp-nav-link.active i {
                color: #fff;
            }

    @@media (max-width: 700px) {
        .cp-nav-link {
            padding: 10px 14px;
            font-size: 13px;
        }
    }
</style>
<div class="cp-sticky-header">
    <div class="cp-nav-tabs">

        <a class="cp-nav-link @(action == "PersonalInformation" ? "active" : "")"
           href="@Url.Action("PersonalInformation", "Admission", new { applicationId = navApplicationId })">
            <i class="fas fa-user"></i> Personal Information
        </a>

        <a class="cp-nav-link @(action == "AdmissionInformation" ? "active" : "")"
           href="@Url.Action("AdmissionInformation", "Admission", new { applicationId = navApplicationId })">
            <i class="fas fa-file-signature"></i> Admission Information
        </a>

        <a class="cp-nav-link @(action == "AddressInformation" ? "active" : "")"
           href="@Url.Action("AddressInformation", "Admission", new { applicationId = navApplicationId })">
            <i class="fas fa-map-marker-alt"></i> Address Information
        </a>

        <a class="cp-nav-link @(action == "ParentDetails" ? "active" : "")"
           href="@Url.Action("ParentDetails", "Admission", new { applicationId = navApplicationId })">
            <i class="fas fa-users"></i> Parent Details
        </a>

        <a class="cp-nav-link @(action == "BankDetails" ? "active" : "")"
           href="@Url.Action("BankDetails", "Admission", new { applicationId = navApplicationId })">
            <i class="fas fa-university"></i> Bank Details
        </a>

        <a class="cp-nav-link @(action == "AcademicRecords" ? "active" : "")"
           href="@Url.Action("AcademicRecords", "Admission", new { applicationId = navApplicationId })">
            <i class="fas fa-book"></i> Academic Records
        </a>

        <a class="cp-nav-link @(action == "AdditionalDetails" ? "active" : "")"
           href="@Url.Action("AdditionalDetails", "Admission", new { applicationId = navApplicationId })">
            <i class="fas fa-plus-circle"></i> Additional Details
        </a>

    </div>
</div>
