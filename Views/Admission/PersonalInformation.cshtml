@using Regis.Models
@{
    ViewBag.Title = "PersonalInformation";
    Layout = "~/Views/Shared/_mainLayout.cshtml";
}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<link href="~/Content/CSS/academicSession.css" rel="stylesheet" />
<link href="~/Content/CSS/eligibilityCheck.css" rel="stylesheet" />
@Html.Partial("_NewAdmission");

<!-- DataTables (search + pagination on list) -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/datatables/1.13.8/css/jquery.dataTables.min.css">
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/datatables/1.13.8/js/jquery.dataTables.min.js"></script>
<script>
    // Some layouts load their own jQuery elsewhere on the page (often at the bottom of _mainLayout),
    // which overwrites window.$/jQuery and wipes out the DataTables plugin attached above,
    // causing "Cannot read properties of undefined (reading 'ext')". Grabbing our own copy here
    // via noConflict(true) protects this page's DataTable/search code from that collision.
    var piJQ = window.jQuery ? window.jQuery.noConflict(true) : null;
</script>

<!-- Export libraries -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.8.2/jspdf.plugin.autotable.min.js"></script>


<div class="as-wrap">

    <!-- ================= LIST PAGE ================= -->
    <div class="as-card" id="piListWrap">
        <div class="as-list-head">
            <div>
                <h2><i class="fas fa-user-plus"></i> New Admission <span style="font-size:12px; color:#7C5CFC; font-weight:700;">STEP 1 · PERSONAL INFORMATION</span></h2>
                <p>Submitting here creates an Application (Application Number auto-generated) that flows to the next steps.</p>
            </div>
            <button class="as-btn as-btn-primary" onclick="window.location.href='/Admission/EligibilityCheck'">
                <i class="fas fa-plus-circle"></i> Add New
            </button>
        </div>

        <div class="pi-filter-bar">
            <div class="pi-filter-field">
                <label>Name</label>
                <input type="text" id="piFilterName" placeholder="Search by name" onkeydown="if(event.key==='Enter') piApplyFilters();">
            </div>
            <div class="pi-filter-field">
                <label>Email</label>
                <input type="text" id="piFilterEmail" placeholder="Search by email" onkeydown="if(event.key==='Enter') piApplyFilters();">
            </div>
            <div class="pi-filter-field">
                <label>Number</label>
                <input type="text" id="piFilterNumber" placeholder="Search by number" onkeydown="if(event.key==='Enter') piApplyFilters();">
            </div>
            <button type="button" class="pi-search-btn" onclick="piApplyFilters()" title="Search"><i class="fas fa-search"></i> Search</button>
            <button type="button" class="pi-reset-btn" onclick="piResetFilters()">Reset</button>
            <button type="button" class="pi-export-btn" onclick="piOpenExportModal()">
                <i class="fas fa-file-export"></i> Export
            </button>
        </div>


        <div class="as-table-wrapper">
            <table class="as-table as-list-table" id="piDataTable" style="width:100%;">
                <thead>
                    <tr>
                        <th>Application No.</th>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Phone</th>
                        <th>Gender</th>
                        <th>Citizenship</th>
                        <th>Registered On</th>
                        <th>Stage</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody id="piTableBody">
                    <tr><td colspan="9" style="text-align:center; color:#6B7A99;">Loading...</td></tr>
                </tbody>
            </table>
        </div>
    </div>

    <!-- ================= ADD / EDIT / VIEW FORM ================= -->
    <div class="sa-wrap" id="piFormWrap" style="display:none; margin-top:10px;">
        <div class="as-back-row">
            <button class="as-back-link" onclick="piShowList()"><i class="fas fa-arrow-left"></i> Back to List</button>
        </div>

        <div class="sa-header" id="piFormTitle">Student admission form</div>
        <div class="sa-body">

            <input type="hidden" id="piApplicationId" value="0" />
            <input type="hidden" id="piSetupId" value="0" />

            <div class="sa-grid2">
                <!-- Basic information -->
                <div class="sa-card">
                    <div class="sa-card-head sa-purple"><i class="fas fa-user"></i> Basic information</div>
                    <div class="sa-card-body">
                        <div class="sa-photo-box">
                            <div class="sa-photo-circle" id="piPhotoCircle"><i class="fas fa-user"></i></div>
                            <div>
                                <button type="button" class="sa-photo-btn" onclick="document.getElementById('piPhotoInput').click()">Upload photo</button>
                                <input type="file" id="piPhotoInput" accept="image/*" style="display:none" onchange="piPreviewPhoto(this)">
                                <div class="sa-photo-hint">PNG, JPG or JPEG · Max 2 MB · Passport size only</div>
                            </div>
                        </div>
                        <div class="sa-field">
                            <label>Title</label>
                            <select id="piTitle"><option value="">Choose</option><option>Mr.</option><option>Ms.</option><option>Mrs.</option><option>Dr.</option></select>
                        </div>
                        <div class="sa-field">
                            <label>First name <span class="req">*</span></label>
                            <input type="text" id="piFirstName" oninput="piBuildDisplayName()">
                        </div>
                        <div class="sa-field">
                            <label>Middle name</label>
                            <input type="text" id="piMiddleName" oninput="piBuildDisplayName()">
                        </div>
                        <div class="sa-field">
                            <label>Last name</label>
                            <input type="text" id="piLastName" oninput="piBuildDisplayName()">
                        </div>
                        <div class="sa-field">
                            <label>Display name format</label>
                            <select id="piDisplayNameFormat" onchange="piBuildDisplayName()">
                                <option value="First Last">First Last</option>
                                <option value="Last, First">Last, First</option>
                                <option value="First Middle Last">First Middle Last</option>
                            </select>
                        </div>
                        <div class="sa-field">
                            <label>Display name</label>
                            <input type="text" id="piDisplayName" readonly placeholder="Auto-generated">
                        </div>
                        <div class="sa-field">
                            <label>Marital status</label>
                            <select id="piMaritalStatus"><option value="">Choose</option><option>Single</option><option>Married</option></select>
                        </div>
                        <div class="sa-field">
                            <label>Gender <span class="req">*</span></label>
                            <select id="piGender"><option value="Male">Male</option><option value="Female">Female</option><option value="Other">Other</option></select>
                        </div>
                        <div class="sa-field">
                            <label>Date of birth <span class="req">*</span></label>
                            <input type="date" id="piDob">
                        </div>
                        <div class="sa-field">
                            <label>Email ID <span class="req">*</span></label>
                            <input type="email" id="piEmail" placeholder="name@example.com">
                        </div>
                    </div>
                </div>

                <!-- Admin information -->
                <div class="sa-card">
                    <div class="sa-card-head sa-orange"><i class="fas fa-id-badge"></i> Admin information</div>
                    <div class="sa-card-body sa-cols2">
                        <div class="sa-field">
                            <label>Registration number</label>
                            <input type="text" readonly placeholder="Auto-generated at Admission (Final)">
                        </div>
                        <div class="sa-field">
                            <label>University / enrollment number</label>
                            <input type="text" readonly placeholder="Auto-generated at Admission (Final)">
                        </div>
                        <div class="sa-field" style="grid-column:span 2;">
                            <label>Application number</label>
                            <input type="text" id="piApplicationNo" readonly placeholder="Auto-generated on first save">
                        </div>
                    </div>
                </div>
            </div>

            <!-- Personal information -->
            <div class="sa-card" style="margin-bottom:18px;">
                <div class="sa-card-head sa-blue"><i class="fas fa-id-card"></i> Personal information</div>
                <div class="sa-card-body">
                    <div class="sa-field"><label>Birth state</label><input type="text" id="piBirthState"></div>
                    <div class="sa-field"><label>Birth place</label><input type="text" id="piBirthPlace"></div>
                    <div class="sa-field">
                        <label>WhatsApp mobile number</label>
                        <div class="sa-mobile-row"><span>+91</span><input type="text" id="piWhatsApp" maxlength="10"></div>
                    </div>
                    <div class="sa-field"><label>Referral source</label><input type="text" id="piReferral"></div>
                    <div class="sa-field">
                        <label>Physically challenged</label>
                        <div class="sa-radio-row">
                            <label><input type="radio" name="piPhysicallyChallenged" value="true"> Yes</label>
                            <label><input type="radio" name="piPhysicallyChallenged" value="false" checked> No</label>
                        </div>
                    </div>
                    <div class="sa-field">
                        <label>Blood group</label>
                        <select id="piBloodGroup">
                            <option value="">Choose</option>
                            <option>A+</option>
                            <option>A-</option>
                            <option>B+</option>
                            <option>B-</option>
                            <option>O+</option>
                            <option>O-</option>
                            <option>AB+</option>
                            <option>AB-</option>
                        </select>
                    </div>
                    <div class="sa-field"><label>Identity mark</label><input type="text" id="piIdentityMark" placeholder="e.g. Mole on left cheek"></div>
                    <div class="sa-field"><label>Mother tongue</label><input type="text" id="piMotherTongue"></div>
                </div>
            </div>

            <div class="sa-grid2">
                <!-- Contact details -->
                <div class="sa-card">
                    <div class="sa-card-head sa-green"><i class="fas fa-phone-alt"></i> Contact details</div>
                    <div class="sa-card-body sa-cols2">
                        <div class="sa-field"><label>Institute email ID</label><input type="text" id="piInstituteEmail"></div>
                        <div class="sa-field">
                            <label>Mobile number <span class="req">*</span></label>
                            <div class="sa-mobile-row"><span>+91</span><input type="text" id="piPhone" maxlength="10" inputmode="numeric" oninput="piValidatePhoneInput(this)"></div>
                        </div>
                        <div class="sa-field">
                            <label>Alternate mobile number</label>
                            <div class="sa-mobile-row"><span>+91</span><input type="text" id="piAltMobile" maxlength="10"></div>
                        </div>
                    </div>
                </div>

                <!-- Identity & domicile -->
                <div class="sa-card">
                    <div class="sa-card-head sa-pink"><i class="fas fa-globe"></i> Identity and domicile</div>
                    <div class="sa-card-body sa-cols2">
                        <div class="sa-field">
                            <label>Citizenship <span class="req">*</span></label>
                            <input type="text" id="piCitizenship" placeholder="e.g. Indian">
                        </div>
                        <div class="sa-field"><label>Domicile country</label><input type="text" id="piDomicileCountry"></div>
                        <div class="sa-field"><label>Domicile state</label><input type="text" id="piDomicileState"></div>
                        <div class="sa-field"><label>Nationality</label><input type="text" id="piNationality"></div>
                        <div class="sa-field"><label>Religion</label><input type="text" id="piReligion"></div>
                        <div class="sa-field"><label>Caste</label><input type="text" id="piCaste"></div>
                        <div class="sa-field"><label>ABC ID</label><input type="text" id="piAbcId"></div>
                        <div class="sa-field"><label>Anti-Ragging ID</label><input type="text" id="piAntiRaggingId"></div>
                    </div>
                </div>
            </div>

            <div class="sa-bar">
                <button class="as-btn as-btn-ghost" onclick="piShowList()">Cancel</button>
                <button class="as-btn as-btn-primary" id="piSubmitBtn" onclick="piSave()"><i class="fas fa-save"></i> <span id="piSubmitText">Save &amp; Submit</span></button>
            </div>
        </div>
    </div>
</div>

<!-- ================= EXPORT MODAL ================= -->
<div class="pi-modal-overlay" id="piExportModal">
    <div class="pi-modal-box">
        <div class="pi-modal-head">
            <h3>Download</h3>
            <button type="button" class="pi-modal-close" onclick="piCloseExportModal()">&times;</button>
        </div>

        <div class="pi-modal-label">Column Name</div>
        <div class="pi-tag-wrap" id="piExportTags"></div>

        <div class="pi-modal-row">
            <label>Entries</label>
            <select id="piExportEntries">
                <option value="current">Current</option>
                <option value="all">All</option>
            </select>
        </div>

        <div class="pi-modal-actions">
            <button type="button" class="pi-btn-excel" onclick="piExportExcel()"><i class="fas fa-file-excel"></i> Excel Download</button>
            <button type="button" class="pi-btn-pdf" onclick="piExportPdf()"><i class="fas fa-file-pdf"></i> PDF Download</button>
        </div>
    </div>
</div>

<div class="as-toast" id="piToast"><i class="fas fa-check-circle"></i><span id="piToastMessage">Success!</span></div>

<script>
    var piCurrentList = [];
    var piDataTable = null;

    // Master column definition used by the table + export modal.
    // "included" controls whether a column is currently selected for export (tags with an × remove it from this list).
    var piExportColumns = [
        { key: 'ApplicationNo', label: 'Application No.', included: true },
        { key: 'FullName', label: 'Name', included: true },
        { key: 'Email', label: 'Email', included: true },
        { key: 'Phone', label: 'Phone', included: true },
        { key: 'Gender', label: 'Gender', included: true },
        { key: 'Citizenship', label: 'Citizenship', included: true },
        { key: 'RegisteredOn', label: 'Registered On', included: true },
        { key: 'Stage', label: 'Stage', included: true }
    ];

    document.addEventListener('DOMContentLoaded', function () {
        var qsAppId = getQueryParam('applicationId');
        var qsName = getQueryParam('name');
        var qsSetupId = getQueryParam('setupId');

        if (qsAppId) {
            // AllStudents page se Edit click hoke aaya — seedha edit form kholo
            piShowForm(parseInt(qsAppId), false);
            if (window.history && window.history.replaceState) {
                window.history.replaceState({}, document.title, window.location.pathname);
            }
        } else if (qsName) {
            // Eligibility Check se aaya — seedha form kholo, naam pre-fill karo, course setup bhi carry karo
            piShowForm(null, false);
            document.getElementById('piFirstName').value = qsName;
            if (qsSetupId) document.getElementById('piSetupId').value = qsSetupId;
            piBuildDisplayName();
            if (window.history && window.history.replaceState) {
                window.history.replaceState({}, document.title, window.location.pathname);
            }
        } else {
            piLoadList();
        }
    });

    function getQueryParam(name) {
        var params = new URLSearchParams(window.location.search);
        return params.get(name);
    }

    function piShowToast(msg, type) {
        const toast = document.getElementById('piToast');
        toast.querySelector('span').textContent = msg;
        toast.className = 'as-toast show ' + (type || '');
        setTimeout(() => toast.classList.remove('show'), 3000);
    }

    function piValidatePhoneInput(input) {
        input.value = input.value.replace(/[^0-9]/g, '').slice(0, 10);
    }

    function piPreviewPhoto(input) {
        if (!input.files || !input.files[0]) return;
        const reader = new FileReader();
        reader.onload = e => {
            document.getElementById('piPhotoCircle').innerHTML = '<img src="' + e.target.result + '">';
        };
        reader.readAsDataURL(input.files[0]);
    }

    function piBuildDisplayName() {
        const first = document.getElementById('piFirstName').value.trim();
        const middle = document.getElementById('piMiddleName').value.trim();
        const last = document.getElementById('piLastName').value.trim();
        const format = document.getElementById('piDisplayNameFormat').value;

        let display = '';
        if (format === 'Last, First') display = [last, first].filter(Boolean).join(', ');
        else if (format === 'First Middle Last') display = [first, middle, last].filter(Boolean).join(' ');
        else display = [first, last].filter(Boolean).join(' ');

        document.getElementById('piDisplayName').value = display;
    }

    // ----- LIST -----
    function piLoadList() {
        fetch('/Admission/GetAllPersonalInformation')
            .then(res => res.json())
            .then(data => {
                piCurrentList = data;
                piRenderTable();
            })
            .catch(() => piShowToast('Unable to load applications', 'error'));
    }
    // paste karo piRenderTable() ke UPAR
    function parseAspDate(v) {
        if (!v) return null;
        var m = /\/Date\((\d+)\)\//.exec(v);
        var d = m ? new Date(parseInt(m[1])) : new Date(v);
        return isNaN(d.getTime()) ? null : d;
    }
    function piRenderTable(list) {
        const rows = list || piCurrentList;
        piFilteredList = rows; // remember what's currently on screen, used by Export "Current"

        const tbody = document.getElementById('piTableBody');
        tbody.innerHTML = '';

        // Destroy any existing DataTable instance before re-rendering rows
        if (piDataTable) {
            piDataTable.destroy();
            piDataTable = null;
        }

        if (!rows || rows.length === 0) {
            const msg = (piCurrentList && piCurrentList.length > 0)
                ? 'No matching applications found'
                : 'No applications yet — click "Add New" to register a student';
            tbody.innerHTML = '<tr><td colspan="9" style="text-align:center; color:#6B7A99;">' + msg + '</td></tr>';
            piInitDataTable(false);
            return;
        }

        rows.forEach(r => {
            const row = document.createElement('tr');
            row.innerHTML =
                '<td>' + (r.ApplicationNo || '-') + '</td>' +
                '<td><strong>' + (r.FullName || '') + '</strong></td>' +
                '<td>' + (r.Email || '') + '</td>' +
                '<td>' + (r.Phone || '') + '</td>' +
                '<td>' + (r.Gender || '') + '</td>' +
                '<td>' + (r.Citizenship || '') + '</td>' +
                '<td>' + (parseAspDate(r.RegisteredOn) ? parseAspDate(r.RegisteredOn).toLocaleDateString('en-GB') : '-') + '</td>' +
                '<td><span class="as-pill as-pill-draft">' + (r.Stage || '') + '</span></td>' +
                '<td>' +
                '<button type="button" class="as-mini-btn" title="View" onclick="piShowForm(' + r.ApplicationId + ', true)"><i class="fas fa-eye"></i></button>' +
                '<button type="button" class="as-mini-btn" title="Edit" onclick="piShowForm(' + r.ApplicationId + ', false)"><i class="fas fa-edit"></i></button>' +
                '</td>';
            tbody.appendChild(row);
        });

        piInitDataTable(true);
    }

    var piFilteredList = []; // list currently shown on screen (after Name/Email/Number search) — used by Export "Current"

    // Initialise (or re-initialise) the DataTable — adds pagination on top of whatever rows are currently in the table body.
    function piInitDataTable(hasData) {
        if (!piJQ || !piJQ.fn || !piJQ.fn.dataTable) {
            console.error('jQuery/DataTables failed to load — pagination will not work on this page.');
            return;
        }
        piDataTable = piJQ('#piDataTable').DataTable({
            destroy: true,
            paging: hasData,
            searching: false,   // filtering is handled ourselves via the Name/Email/Number fields, not DataTables' own search
            info: hasData,
            lengthChange: hasData,
            ordering: hasData,
            columnDefs: [{ orderable: false, targets: -1 }] // Actions column not sortable
        });
    }

    // Filters piCurrentList by the Name/Email/Number fields (each matched independently, case-insensitive, partial match)
    // and re-renders the table with the result. Simple and reliable — doesn't depend on DataTables' own filtering.
    function piApplyFilters() {
        const nameTerm = document.getElementById('piFilterName').value.trim().toLowerCase();
        const emailTerm = document.getElementById('piFilterEmail').value.trim().toLowerCase();
        const numberTerm = document.getElementById('piFilterNumber').value.trim().toLowerCase();

        if (!nameTerm && !emailTerm && !numberTerm) {
            piRenderTable(piCurrentList);
            return;
        }

        const filtered = (piCurrentList || []).filter(r => {
            if (nameTerm && !(r.FullName || '').toLowerCase().includes(nameTerm)) return false;
            if (emailTerm && !(r.Email || '').toLowerCase().includes(emailTerm)) return false;
            if (numberTerm && !(r.Phone || '').toLowerCase().includes(numberTerm)) return false;
            return true;
        });

        piRenderTable(filtered);
    }

    // Clears all search fields and shows the full list again.
    function piResetFilters() {
        document.getElementById('piFilterName').value = '';
        document.getElementById('piFilterEmail').value = '';
        document.getElementById('piFilterNumber').value = '';
        piRenderTable(piCurrentList);
    }

    // ----- SHOW FORM (Add / Edit / View) -----
    function piShowForm(applicationId, readOnly) {
        piResetForm();

        const fieldIds = ['piTitle', 'piFirstName', 'piMiddleName', 'piLastName', 'piDisplayNameFormat', 'piMaritalStatus',
            'piGender', 'piDob', 'piEmail', 'piPhone', 'piBirthState', 'piBirthPlace', 'piWhatsApp', 'piReferral',
            'piBloodGroup', 'piIdentityMark', 'piMotherTongue', 'piInstituteEmail', 'piAltMobile',
            'piCitizenship', 'piDomicileCountry', 'piDomicileState', 'piNationality', 'piReligion', 'piCaste',
            'piAbcId', 'piAntiRaggingId'];
        fieldIds.forEach(id => document.getElementById(id).disabled = !!readOnly);
        document.querySelectorAll('input[name="piPhysicallyChallenged"]').forEach(r => r.disabled = !!readOnly);

        document.getElementById('piSubmitBtn').style.display = readOnly ? 'none' : 'inline-flex';
        document.getElementById('piFormTitle').textContent = readOnly ? 'View admission form' : 'Student admission form';
        document.getElementById('piSubmitText').textContent = applicationId ? 'Update' : 'Save & Submit';

        if (applicationId) {
            fetch('/Admission/GetPersonalInformationById?applicationId=' + applicationId)
                .then(res => res.json())
                .then(m => {
                    document.getElementById('piApplicationId').value = m.ApplicationId;
                    document.getElementById('piApplicationNo').value = m.ApplicationNo || '';
                    document.getElementById('piTitle').value = m.Title || '';
                    document.getElementById('piFirstName').value = m.FirstName || '';
                    document.getElementById('piMiddleName').value = m.MiddleName || '';
                    document.getElementById('piLastName').value = m.LastName || '';
                    document.getElementById('piDisplayNameFormat').value = m.DisplayNameFormat || 'First Last';
                    document.getElementById('piDisplayName').value = m.DisplayName || '';
                    document.getElementById('piMaritalStatus').value = m.MaritalStatus || '';
                    document.getElementById('piGender').value = m.Gender || 'Male';
                    document.getElementById('piDob').value = m.DOB ? m.DOB.substring(0, 10) : '';
                    document.getElementById('piEmail').value = m.Email || '';
                    document.getElementById('piPhone').value = m.Phone || '';
                    document.getElementById('piBirthState').value = m.BirthState || '';
                    document.getElementById('piBirthPlace').value = m.BirthPlace || '';
                    document.getElementById('piWhatsApp').value = (m.WhatsAppNumber || '').replace('+91-', '');
                    document.getElementById('piReferral').value = m.ReferralSource || '';
                    document.querySelector('input[name="piPhysicallyChallenged"][value="' + (m.PhysicallyChallenged ? 'true' : 'false') + '"]').checked = true;
                    document.getElementById('piBloodGroup').value = m.BloodGroup || '';
                    document.getElementById('piIdentityMark').value = m.IdentityMark || '';
                    document.getElementById('piMotherTongue').value = m.MotherTongue || '';
                    document.getElementById('piAltMobile').value = (m.AlternateMobileNumber || '').replace('+91-', '');
                    document.getElementById('piCitizenship').value = m.Citizenship || '';
                    document.getElementById('piDomicileCountry').value = m.DomicileCountry || '';
                    document.getElementById('piDomicileState').value = m.DomicileState || '';
                    document.getElementById('piNationality').value = m.Nationality || '';
                    document.getElementById('piReligion').value = m.Religion || '';
                    document.getElementById('piCaste').value = m.Caste || '';
                    document.getElementById('piAbcId').value = m.ABCId || '';
                    document.getElementById('piAntiRaggingId').value = m.AntiRaggingId || '';

                    piGoToFormView();
                })
                .catch(() => piShowToast('Unable to load application', 'error'));
        } else {
            piGoToFormView();
        }
    }

    function piGoToFormView() {
        document.getElementById('piListWrap').style.display = 'none';
        document.getElementById('piFormWrap').style.display = 'block';
        window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    function piResetForm() {
        document.getElementById('piApplicationId').value = 0;
        document.getElementById('piSetupId').value = 0;
        document.getElementById('piApplicationNo').value = '';
        document.getElementById('piPhotoCircle').innerHTML = '<i class="fas fa-user"></i>';
        ['piTitle', 'piFirstName', 'piMiddleName', 'piLastName', 'piMaritalStatus', 'piDob', 'piEmail', 'piPhone',
            'piBirthState', 'piBirthPlace', 'piWhatsApp', 'piReferral', 'piBloodGroup', 'piIdentityMark', 'piMotherTongue',
            'piInstituteEmail', 'piAltMobile', 'piCitizenship', 'piDomicileCountry', 'piDomicileState', 'piNationality',
            'piReligion', 'piCaste', 'piAbcId', 'piAntiRaggingId', 'piDisplayName'].forEach(id => document.getElementById(id).value = '');
        document.getElementById('piDisplayNameFormat').value = 'First Last';
        document.getElementById('piGender').value = 'Male';
        document.querySelector('input[name="piPhysicallyChallenged"][value="false"]').checked = true;
    }

    function piShowList() {
        document.getElementById('piFormWrap').style.display = 'none';
        document.getElementById('piListWrap').style.display = 'block';
        piLoadList();
        window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    // ----- SAVE (Insert or Update) -----
    function piSave() {
        const firstName = document.getElementById('piFirstName').value.trim();
        if (!firstName) { piShowToast('First Name is required', 'error'); return; }
        const email = document.getElementById('piEmail').value.trim();
        if (!email) { piShowToast('Email is required', 'error'); return; }
        const phone = document.getElementById('piPhone').value.trim();
        if (!/^[0-9]{10}$/.test(phone)) { piShowToast('Phone must be exactly 10 digits', 'error'); return; }
        const citizenship = document.getElementById('piCitizenship').value.trim();
        if (!citizenship) { piShowToast('Please enter Citizenship', 'error'); return; }

        const payload = {
            ApplicationId: parseInt(document.getElementById('piApplicationId').value) || 0,
            Email: email,
            Phone: phone,
            DOB: document.getElementById('piDob').value || null,
            Gender: document.getElementById('piGender').value,

            Title: document.getElementById('piTitle').value,
            FirstName: firstName,
            MiddleName: document.getElementById('piMiddleName').value,
            LastName: document.getElementById('piLastName').value,
            DisplayNameFormat: document.getElementById('piDisplayNameFormat').value,
            DisplayName: document.getElementById('piDisplayName').value,
            MaritalStatus: document.getElementById('piMaritalStatus').value,

            BirthState: document.getElementById('piBirthState').value,
            BirthPlace: document.getElementById('piBirthPlace').value,
            WhatsAppNumber: document.getElementById('piWhatsApp').value ? ('+91-' + document.getElementById('piWhatsApp').value) : '',
            ReferralSource: document.getElementById('piReferral').value,
            PhysicallyChallenged: document.querySelector('input[name="piPhysicallyChallenged"]:checked').value === 'true',
            BloodGroup: document.getElementById('piBloodGroup').value,
            IdentityMark: document.getElementById('piIdentityMark').value,
            MotherTongue: document.getElementById('piMotherTongue').value,
            AlternateMobileNumber: document.getElementById('piAltMobile').value ? ('+91-' + document.getElementById('piAltMobile').value) : '',

            Citizenship: citizenship,
            DomicileCountry: document.getElementById('piDomicileCountry').value,
            DomicileState: document.getElementById('piDomicileState').value,
            Nationality: document.getElementById('piNationality').value,
            Religion: document.getElementById('piReligion').value,
            Caste: document.getElementById('piCaste').value,
            ABCId: document.getElementById('piAbcId').value,
            AntiRaggingId: document.getElementById('piAntiRaggingId').value
        };

        fetch('/Admission/SavePersonalInformation', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload)
        })
            .then(res => res.json())
            .then(data => {
                if (!data.success) { piShowToast(data.message, 'error'); return; }
                piShowToast(data.message, 'success');
                var isNew = !payload.ApplicationId;
                var appId = data.applicationId;
                var setupId = document.getElementById('piSetupId').value;
                setTimeout(() => {
                    if (isNew && appId) {
                        var url = '/Admission/AdmissionInformation?applicationId=' + appId;
                        if (setupId && setupId !== '0') url += '&setupId=' + setupId;
                        window.location.href = url;
                    } else {
                        piShowList();
                    }
                }, 700);
            })
            .catch(() => piShowToast('Server error while saving', 'error'));
    }

    // ===================== EXPORT MODAL =====================

    function piOpenExportModal() {
        piRenderExportTags();
        document.getElementById('piExportModal').classList.add('show');
    }

    function piCloseExportModal() {
        document.getElementById('piExportModal').classList.remove('show');
    }

    // Renders the column tags. Clicking × removes that column from the export (sets included = false)
    // and drops the tag from view. Once removed a column stays excluded until page reload.
    function piRenderExportTags() {
        const wrap = document.getElementById('piExportTags');
        wrap.innerHTML = '';
        piExportColumns.forEach((col, idx) => {
            if (!col.included) return;
            const tag = document.createElement('span');
            tag.className = 'pi-tag';
            tag.innerHTML = col.label + ' <button type="button" title="Remove column">&times;</button>';
            tag.querySelector('button').onclick = function () {
                piExportColumns[idx].included = false;
                piRenderExportTags();
            };
            wrap.appendChild(tag);
        });

        if (!piExportColumns.some(c => c.included)) {
            wrap.innerHTML = '<span style="font-size:12.5px;color:#9CA3AF;">No columns selected</span>';
        }
    }

    // Returns the row data to export, respecting the Entries dropdown
    // (Current = whatever the Name/Email/Number search is currently showing, All = full unfiltered list)
    function piGetExportRows() {
        const mode = document.getElementById('piExportEntries').value;
        return mode === 'all' ? piCurrentList : piFilteredList;
    }

    function piGetSelectedColumns() {
        return piExportColumns.filter(c => c.included);
    }

    function piFormatCell(col, row) {
        if (col.key === 'RegisteredOn') {
            const d = parseAspDate(row.RegisteredOn);
            return d ? d.toLocaleDateString('en-GB') : '-';
        }
        return row[col.key] || '';
    }

    function piExportExcel() {
        const cols = piGetSelectedColumns();
        if (cols.length === 0) { piShowToast('Please select at least one column', 'error'); return; }
        const rows = piGetExportRows();
        if (rows.length === 0) { piShowToast('No data to export', 'error'); return; }

        const data = rows.map(r => {
            const obj = {};
            cols.forEach(c => obj[c.label] = piFormatCell(c, r));
            return obj;
        });

        const ws = XLSX.utils.json_to_sheet(data);
        const wb = XLSX.utils.book_new();
        XLSX.utils.book_append_sheet(wb, ws, 'Applications');
        XLSX.writeFile(wb, 'PersonalInformation.xlsx');
        piCloseExportModal();
    }

    function piExportPdf() {
        const cols = piGetSelectedColumns();
        if (cols.length === 0) { piShowToast('Please select at least one column', 'error'); return; }
        const rows = piGetExportRows();
        if (rows.length === 0) { piShowToast('No data to export', 'error'); return; }

        const { jsPDF } = window.jspdf;
        const doc = new jsPDF({ orientation: cols.length > 5 ? 'landscape' : 'portrait' });

        const head = [cols.map(c => c.label)];
        const body = rows.map(r => cols.map(c => piFormatCell(c, r)));

        doc.autoTable({
            head: head,
            body: body,
            styles: { fontSize: 8 },
            headStyles: { fillColor: [16, 185, 129] }
        });

        doc.save('PersonalInformation.pdf');
        piCloseExportModal();
    }

    // Close modal on outside click
    document.getElementById('piExportModal').addEventListener('click', function (e) {
        if (e.target === this) piCloseExportModal();
    });
</script>
