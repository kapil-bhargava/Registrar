@using Regis.Models
@{
    ViewBag.Title = "FeePayment";
    Layout = "~/Views/Shared/_mainLayout.cshtml";
    var pending = ViewBag.PendingFee as List<ApplicationModel> ?? new List<ApplicationModel>();
    var app = ViewBag.App as ApplicationModel;
    int? appId = ViewBag.AppId;
    var feeHeads = ViewBag.FeeHeads as List<FeeHeadModel> ?? new List<FeeHeadModel>();
    decimal totalPayable = feeHeads.Sum(f => f.Amount);
}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<link href="~/Content/CSS/academicSession.css" rel="stylesheet" />
<link href="~/Content/CSS/eligibilityCheck.css" rel="stylesheet" />

<div class="as-wrap">

    @if (!appId.HasValue)
    {
        <!-- ================= LIST MODE ================= -->
        <div class="as-card">
            <div class="as-list-head">
                <div>
                    <h2><i class="fas fa-sack-dollar"></i> Fee Payment <span style="font-size:12px; color:#7C5CFC; font-weight:700;">STEP 7</span></h2>
                    <p>Only applications with <strong>counselling completed &amp; seat allotted</strong> appear here.</p>
                </div>
            </div>
            <div class="as-table-wrapper">
                <table class="as-table as-list-table">
                    <thead><tr><th>Application No.</th><th>Name</th><th>Course</th><th>Seat No.</th><th>Status</th><th>Actions</th></tr></thead>
                    <tbody>
                        @if (pending.Count == 0)
                        {
                            <tr><td colspan="6" style="text-align:center; color:#6B7A99;">No applications ready for fee payment yet</td></tr>
                        }
                        else
                        {
                            foreach (var a in pending)
                            {
                                <tr>
                                    <td>@a.ApplicationNo</td>
                                    <td><strong>@a.FullName</strong></td>
                                    <td>@a.CourseName</td>
                                    <td>@(a.SeatNumber ?? "—")</td>
                                    <td><span class="as-pill as-pill-closed"><i class="fas fa-comments"></i> Counselling Done</span></td>
                                    <td><a class="as-btn as-btn-primary as-btn-sm" href="@Url.Action("FeePayment", "Admission", new { appId = a.ApplicationId })">Collect Fee</a></td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
    else
    {
        <!-- ================= DETAIL MODE ================= -->
        <div class="as-card as-wizard-card">
            <div class="as-back-row">
                <a class="as-back-link" href="@Url.Action("Application", "Admission")"><i class="fas fa-arrow-left"></i> Back to Application Management</a>
            </div>
            <div class="as-body">
                <div class="as-page active">
                    <div class="as-head">
                        <div class="as-icon"><i class="fas fa-sack-dollar"></i></div>
                        <div>
                            <h2>Collect Admission Fee</h2>
                            <p>Application @(app != null ? app.ApplicationNo : "—")</p>
                        </div>
                    </div>

                    <div class="as-current-session">
                        <div class="as-current-label">👤 Applicant</div>
                        <div class="as-current-value">@(app != null ? app.FullName : "—")</div>
                        <span class="as-pill as-pill-closed">@(app != null ? app.CourseName + " · Seat: " + app.SeatNumber : "—")</span>
                    </div>

                    <div class="as-section-title"><i class="fas fa-money-check-alt"></i> Fee Breakdown <span class="as-hint" style="margin-left:6px;">(from Fee Heads Master)</span></div>
                    <div class="as-table-wrapper">
                        <table class="as-table">
                            <thead><tr><th>Fee Head</th><th>Amount (₹)</th></tr></thead>
                            <tbody>
                                @if (feeHeads.Count == 0)
                                {
                                    <tr><td colspan="2" style="text-align:center; color:#6B7A99;">No active fee heads configured</td></tr>
                                }
                                else
                                {
                                    foreach (var f in feeHeads)
                                    {
                                        <tr>
                                            <td>@f.FeeHeadName</td>
                                            <td>₹@f.Amount.ToString("N0")</td>
                                        </tr>
                                    }
                                }
                                <tr style="font-weight:700;"><td>Total Payable</td><td>₹@totalPayable.ToString("N0")</td></tr>
                            </tbody>
                        </table>
                    </div>

                    <div class="as-section-title"><i class="fas fa-credit-card"></i> Payment Details</div>
                    <div class="as-grid">
                        <div class="as-field">
                            <label>Payment Mode <span class="req">*</span></label>
                            <select id="fpMode">
                                <option value="Online">Online</option>
                                <option value="Cash">Cash</option>
                                <option value="DD">Demand Draft</option>
                            </select>
                        </div>
                        <div class="as-field">
                            <label>Transaction / Receipt No.</label>
                            <input type="text" id="fpReceiptNo" placeholder="Auto-generated on save" readonly disabled>
                        </div>
                    </div>
                    <input type="hidden" id="fpAmount" value="@totalPayable.ToString("F2")">

                    <div class="as-bar">
                        <a class="as-btn as-btn-ghost" href="@Url.Action("Application", "Admission")">Cancel</a>
                        <span></span>
                        <button class="as-btn as-btn-primary" onclick="fpSave()"><i class="fas fa-check-circle"></i> Confirm Payment</button>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<div class="as-toast" id="fpToast"><i class="fas fa-check-circle"></i><span id="fpToastMessage">Success!</span></div>

<script>
    function fpShowToast(msg, type) {
        const toast = document.getElementById('fpToast');
        toast.querySelector('span').textContent = msg;
        toast.className = 'as-toast show ' + (type || '');
        setTimeout(() => toast.classList.remove('show'), 3000);
    }

    function fpSave() {
        const applicationId = @(appId ?? 0);
        const feeMode = document.getElementById('fpMode').value;
        const feeAmount = document.getElementById('fpAmount').value;

        fetch('@Url.Action("SaveFeePayment", "Admission")', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: 'applicationId=' + applicationId + '&feeMode=' + encodeURIComponent(feeMode) + '&feeAmount=' + feeAmount
        })
            .then(res => res.json())
            .then(data => {
                if (!data.success) { fpShowToast(data.message, 'error'); return; }
                document.getElementById('fpReceiptNo').value = data.receiptNo;
                fpShowToast(data.message, 'success');
                setTimeout(() => window.location.href = '@Url.Action("Application", "Admission")', 1200);
            })
            .catch(() => fpShowToast('Server error while collecting fee', 'error'));
    }
</script>