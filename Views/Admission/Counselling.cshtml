@using Regis.Models
@{
    ViewBag.Title = "Counselling";
    Layout = "~/Views/Shared/_mainLayout.cshtml";
    var pending = ViewBag.PendingCounselling as List<ApplicationModel> ?? new List<ApplicationModel>();
    var app = ViewBag.App as ApplicationModel;
    int? appId = ViewBag.AppId;
}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<link href="~/Content/CSS/academicSession.css" rel="stylesheet" />
<link href="~/Content/CSS/eligibilityCheck.css" rel="stylesheet" />

<div class="as-wrap">

    @if (!appId.HasValue)
    {
        <!-- ================= LIST MODE ================= -->
        <div class="as-card">
            <div class="as-list-head">
                <div>
                    <h2><i class="fas fa-comments"></i> Counselling <span style="font-size:12px; color:#7C5CFC; font-weight:700;">STEP 6</span></h2>
                    <p>Only applications with <strong>documents verified</strong> appear here — auto-filtered from Application Management.</p>
                </div>
            </div>
            <div class="as-table-wrapper">
                <table class="as-table as-list-table">
                    <thead><tr><th>Application No.</th><th>Name</th><th>Course</th><th>Category</th><th>Status</th><th>Actions</th></tr></thead>
                    <tbody>
                        @if (pending.Count == 0)
                        {
                            <tr><td colspan="6" style="text-align:center; color:#6B7A99;">No applications ready for counselling yet</td></tr>
                        }
                        else
                        {
                            foreach (var a in pending)
                            {
                                <tr>
                                    <td>@a.ApplicationNo</td>
                                    <td><strong>@a.FullName</strong></td>
                                    <td>@a.CourseName</td>
                                    <td><span class="as-type-badge">@a.CategoryName</span></td>
                                    <td><span class="as-pill as-pill-active"><i class="fas fa-file-check"></i> Docs Verified</span></td>
                                    <td><a class="as-btn as-btn-primary as-btn-sm" href="@Url.Action("Counselling", "Admission", new { appId = a.ApplicationId })">Schedule</a></td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
    else
    {
        <!-- ================= DETAIL MODE ================= -->
        <div class="as-card as-wizard-card">
            <div class="as-back-row">
                <a class="as-back-link" href="@Url.Action("Application", "Admission")"><i class="fas fa-arrow-left"></i> Back to Application Management</a>
            </div>
            <div class="as-body">
                <div class="as-page active">
                    <div class="as-head">
                        <div class="as-icon"><i class="fas fa-comments"></i></div>
                        <div>
                            <h2>Schedule Counselling &amp; Allot Seat</h2>
                            <p>Application @(app != null ? app.ApplicationNo : "—")</p>
                        </div>
                    </div>

                    <div class="as-current-session">
                        <div class="as-current-label">👤 Applicant</div>
                        <div class="as-current-value">@(app != null ? app.FullName : "—")</div>
                        <span class="as-pill as-pill-active">@(app != null ? app.CourseName + " · " + app.CategoryName : "—")</span>
                    </div>

                    <div class="as-section-title"><i class="fas fa-calendar-alt"></i> Counselling Schedule</div>
                    <div class="as-grid">
                        <div class="as-field">
                            <label>Counselling Date <span class="req">*</span></label>
                            <input type="date" id="cnDate">
                        </div>
                        <div class="as-field">
                            <label>Counselling Time</label>
                            <input type="time" id="cnTime">
                        </div>
                        <div class="as-field">
                            <label>Mode</label>
                            <select id="cnMode">
                                <option value="In-Person">In-Person</option>
                                <option value="Online">Online</option>
                            </select>
                        </div>
                    </div>

                    <div class="as-section-title"><i class="fas fa-chair"></i> Seat Allotment</div>
                    <div class="as-grid">
                        <div class="as-field">
                            <label>Category (auto)</label>
                            <input type="text" value="@(app != null ? app.CategoryName : "—")" readonly disabled>
                        </div>
                        <div class="as-field">
                            <label>Allotted Seat No.</label>
                            <input type="text" id="cnSeatNumber" readonly disabled placeholder="Auto-generated on save">
                        </div>
                    </div>

                    <div class="as-bar">
                        <a class="as-btn as-btn-ghost" href="@Url.Action("Application", "Admission")">Cancel</a>
                        <span></span>
                        <button class="as-btn as-btn-primary" onclick="cnSave()"><i class="fas fa-check-circle"></i> Complete Counselling</button>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<div class="as-toast" id="cnToast"><i class="fas fa-check-circle"></i><span id="cnToastMessage">Success!</span></div>

<script>
    function cnShowToast(msg, type) {
        const toast = document.getElementById('cnToast');
        toast.querySelector('span').textContent = msg;
        toast.className = 'as-toast show ' + (type || '');
        setTimeout(() => toast.classList.remove('show'), 3000);
    }

    // ----- Complete Counselling (AJAX -> Controller -> sp_Application SCHEDULECOUNSELLING) -----
    function cnSave() {
        const date = document.getElementById('cnDate').value;
        if (!date) { cnShowToast('Please select a Counselling Date', 'error'); return; }
        const time = document.getElementById('cnTime').value;
        const mode = document.getElementById('cnMode').value;
        const applicationId = @(appId ?? 0);

        fetch('@Url.Action("SaveCounselling", "Admission")', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: 'applicationId=' + applicationId +
                  '&counsellingDate=' + encodeURIComponent(date) +
                  '&counsellingTime=' + encodeURIComponent(time) +
                  '&counsellingMode=' + encodeURIComponent(mode)
        })
            .then(res => res.json())
            .then(data => {
                if (!data.success) { cnShowToast(data.message, 'error'); return; }
                document.getElementById('cnSeatNumber').value = data.seatNumber;
                cnShowToast(data.message, 'success');
                setTimeout(() => window.location.href = '@Url.Action("Application", "Admission")', 1200);
            })
            .catch(() => cnShowToast('Server error while scheduling counselling', 'error'));
    }
</script>
