@using Regis.Models
@{
    ViewBag.Title = "Application";
    Layout = "~/Views/Shared/_mainLayout.cshtml";
    var apps = ViewBag.Applications as List<ApplicationModel> ?? new List<ApplicationModel>();
}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<link href="~/Content/CSS/academicSession.css" rel="stylesheet" />

<div class="as-wrap">

    <div class="as-card">
        <div class="as-list-head">
            <div>
                <h2><i class="fas fa-folder-open"></i> Application Management <span style="font-size:12px; color:#7C5CFC; font-weight:700;">STEP 4</span></h2>
                <p>Every application submitted via <strong>Student Registration</strong> automatically appears here — no re-entry needed.</p>
            </div>
        </div>

        <div class="as-quick-stats">
            <div class="as-stat-card">
                <div class="as-stat-icon"><i class="fas fa-folder-open"></i></div>
                <div class="as-stat-info">
                    <span class="as-stat-number">@apps.Count</span>
                    <span class="as-stat-label">Total Applications</span>
                </div>
            </div>
            <div class="as-stat-card active">
                <div class="as-stat-icon"><i class="fas fa-check-circle"></i></div>
                <div class="as-stat-info">
                    <span class="as-stat-number">@apps.Count(a => a.DocVerified)</span>
                    <span class="as-stat-label">Documents Verified</span>
                </div>
            </div>
            <div class="as-stat-card">
                <div class="as-stat-icon"><i class="fas fa-hourglass-half"></i></div>
                <div class="as-stat-info">
                    <span class="as-stat-number">@apps.Count(a => !a.DocVerified)</span>
                    <span class="as-stat-label">Pending Verification</span>
                </div>
            </div>
        </div>

        <div class="as-table-wrapper">
            <table class="as-table as-list-table">
                <thead>
                    <tr>
                        <th>Application No.</th>
                        <th>Name</th>
                        <th>Course</th>
                        <th>Category</th>
                        <th>Registered On</th>
                        <th>Current Stage</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (apps.Count == 0)
                    {
                        <tr><td colspan="7" style="text-align:center; color:#6B7A99;">No applications yet — register a student first</td></tr>
                    }
                    else
                    {
                        foreach (var a in apps)
                        {
                            <tr>
                                <td>@a.ApplicationNo</td>
                                <td><strong>@a.FullName</strong></td>
                                <td>@a.CourseName</td>
                                <td><span class="as-type-badge">@a.CategoryName</span></td>
                                <td>@a.RegisteredOn.ToString("dd MMM yyyy")</td>
                                <td>
                                    @if (a.StudentId != null)
                                    {
                                        <span class="as-pill as-pill-active"><i class="fas fa-graduation-cap"></i> Admitted</span>
                                    }
                                    else if (a.FeePaid)
                                    {
                                        <span class="as-pill as-pill-locked"><i class="fas fa-check-circle"></i> Fee Paid</span>
                                    }
                                    else if (a.CounsellingDone)
                                    {
                                        <span class="as-pill as-pill-closed"><i class="fas fa-comments"></i> Counselling Done</span>
                                    }
                                    else if (a.DocVerified)
                                    {
                                        <span class="as-pill as-pill-active"><i class="fas fa-file-check"></i> Docs Verified</span>
                                    }
                                    else
                                    {
                                        <span class="as-pill as-pill-draft"><i class="fas fa-clock"></i> Registered</span>
                                    }
                                </td>
                                <td>
                                    <button type="button" class="as-mini-btn" title="View" onclick="alert('Application: @a.ApplicationNo')"><i class="fas fa-eye"></i></button>
                                    @if (!a.DocVerified)
                                    {
                                        <a class="as-mini-btn" title="Verify Documents" href="@Url.Action("DocumentVerification", "Admission", new { appId = a.ApplicationId })"><i class="fas fa-file-check"></i></a>
                                    }
                                    else if (!a.CounsellingDone)
                                    {
                                        <a class="as-mini-btn" title="Counselling" href="@Url.Action("Counselling", "Admission", new { appId = a.ApplicationId })"><i class="fas fa-comments"></i></a>
                                    }
                                    else if (!a.FeePaid)
                                    {
                                        <a class="as-mini-btn" title="Fee Payment" href="@Url.Action("FeePayment", "Admission", new { appId = a.ApplicationId })"><i class="fas fa-sack-dollar"></i></a>
                                    }
                                    else if (a.StudentId == null)
                                    {
                                        <a class="as-mini-btn" title="Final Admission" href="@Url.Action("Final", "Admission", new { appId = a.ApplicationId })"><i class="fas fa-graduation-cap"></i></a>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        <div class="as-legend">
            <span><span class="as-legend-dot draft"></span> Registered</span>
            <span><span class="as-legend-dot active"></span> Docs Verified</span>
            <span><span class="as-legend-dot closed"></span> Counselling Done</span>
            <span><span class="as-legend-dot locked"></span> Fee Paid</span>
        </div>
    </div>
</div>
