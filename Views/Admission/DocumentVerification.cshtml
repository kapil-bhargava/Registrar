@using Regis.Models
@{
    ViewBag.Title = "DocumentVerification";
    Layout = "~/Views/Shared/_mainLayout.cshtml";
    var pendingDocs = ViewBag.PendingDocs as List<ApplicationModel> ?? new List<ApplicationModel>();
    var checklist = ViewBag.Checklist as List<DocumentChecklistItemModel> ?? new List<DocumentChecklistItemModel>();
    var app = ViewBag.App as ApplicationModel;
    int? appId = ViewBag.AppId;
}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<link href="~/Content/CSS/academicSession.css" rel="stylesheet" />
<link href="~/Content/CSS/eligibilityCheck.css" rel="stylesheet" />

<div class="as-wrap">

    @if (!appId.HasValue)
    {
        <!-- ================= LIST MODE ================= -->
        <div class="as-card">
            <div class="as-list-head">
                <div>
                    <h2><i class="fas fa-file-check"></i> Document Verification <span style="font-size:12px; color:#7C5CFC; font-weight:700;">STEP 5</span></h2>
                    <p>Applications pending document verification — auto-pulled from Application Management.</p>
                </div>
            </div>
            <div class="as-table-wrapper">
                <table class="as-table as-list-table">
                    <thead><tr><th>Application No.</th><th>Name</th><th>Course</th><th>Status</th><th>Actions</th></tr></thead>
                    <tbody>
                        @if (pendingDocs.Count == 0)
                        {
                            <tr><td colspan="5" style="text-align:center; color:#6B7A99;">No applications pending verification</td></tr>
                        }
                        else
                        {
                            foreach (var a in pendingDocs)
                            {
                                <tr>
                                    <td>@a.ApplicationNo</td>
                                    <td><strong>@a.FullName</strong></td>
                                    <td>@a.CourseName</td>
                                    <td><span class="as-pill as-pill-draft"><i class="fas fa-clock"></i> Pending</span></td>
                                    <td><a class="as-btn as-btn-primary as-btn-sm" href="@Url.Action("DocumentVerification", "Admission", new { appId = a.ApplicationId })">Verify</a></td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
    else
    {
        <!-- ================= DETAIL MODE ================= -->
        <div class="as-card as-wizard-card">
            <div class="as-back-row">
                <a class="as-back-link" href="@Url.Action("Application", "Admission")"><i class="fas fa-arrow-left"></i> Back to Application Management</a>
            </div>
            <div class="as-body">
                <div class="as-page active">
                    <div class="as-head">
                        <div class="as-icon"><i class="fas fa-file-check"></i></div>
                        <div>
                            <h2>Verify Documents</h2>
                            <p>Application @(app != null ? app.ApplicationNo : "—")</p>
                        </div>
                    </div>

                    <div class="as-current-session">
                        <div class="as-current-label">📄 Applicant</div>
                        <div class="as-current-value">@(app != null ? app.FullName : "—")</div>
                        <span class="as-pill as-pill-draft">@(app != null ? app.CourseName : "—")</span>
                    </div>

                    <div class="as-section-title"><i class="fas fa-list"></i> Required Documents <span class="as-hint" style="margin-left:6px;">(as per selected Course — Required Document Master)</span></div>
                    <div class="as-check-group as-check-col">
                        @if (checklist.Count == 0)
                        {
                            <p class="as-hint">No required documents mapped for this Course yet — add them in Required Document Master.</p>
                        }
                        else
                        {
                            foreach (var d in checklist)
                            {
                                <label class="as-checkbox">
                                    <input type="checkbox" class="dv-doc-check" data-id="@d.DocumentEnclosureId" @(d.IsSubmitted ? "checked" : "")>
                                    <span>
                                        <strong>@d.DocumentName</strong>
                                        @if (d.IsMandatory)
                                        {
                                            <span style="color:#F04452;">*Mandatory</span>
                                        }
                                        else
                                        {
                                            <span style="color:#6B7A99;">(Optional)</span>
                                        }
                                    </span>
                                </label>
                            }
                        }
                    </div>

                    <div class="as-bar">
                        <a class="as-btn as-btn-ghost" href="@Url.Action("Application", "Admission")">Cancel</a>
                        <span></span>
                        <button class="as-btn as-btn-primary" onclick="dvSaveVerification()"><i class="fas fa-check-circle"></i> Save Verification</button>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<div class="as-toast" id="dvToast"><i class="fas fa-check-circle"></i><span id="dvToastMessage">Success!</span></div>

<script>
    function dvShowToast(msg, type) {
        const toast = document.getElementById('dvToast');
        toast.querySelector('span').textContent = msg;
        toast.className = 'as-toast show ' + (type || '');
        setTimeout(() => toast.classList.remove('show'), 3000);
    }

    // ----- Save Verification (AJAX -> Controller -> sp_Application VERIFYDOCS) -----
    function dvSaveVerification() {
        const applicationId = @(appId ?? 0);
        const checkboxes = document.querySelectorAll('.dv-doc-check');
        const submittedIds = [];
        checkboxes.forEach(cb => { if (cb.checked) submittedIds.push(cb.getAttribute('data-id')); });

        fetch('@Url.Action("SaveDocumentVerification", "Admission")', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: 'applicationId=' + applicationId + '&submittedDocumentIdsCsv=' + encodeURIComponent(submittedIds.join(','))
        })
            .then(res => res.json())
            .then(data => {
                dvShowToast(data.message, data.allVerified ? 'success' : 'error');
                setTimeout(() => window.location.href = '@Url.Action("Application", "Admission")', 1200);
            })
            .catch(() => dvShowToast('Server error while saving verification', 'error'));
    }
</script>
