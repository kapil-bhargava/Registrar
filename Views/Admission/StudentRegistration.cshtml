@using Regis.Models
@{
    ViewBag.Title = "StudentRegistration";
    Layout = "~/Views/Shared/_mainLayout.cshtml";

    var admissionModes = ViewBag.AdmissionModes as List<AdmissionModeMasterModel> ?? new List<AdmissionModeMasterModel>();
    var categories = ViewBag.Categories as List<CategoryModel> ?? new List<CategoryModel>();
    var openSetups = ViewBag.OpenSetups as List<AdmissionSetupModel> ?? new List<AdmissionSetupModel>();
}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<link href="~/Content/CSS/academicSession.css" rel="stylesheet" />
<link href="~/Content/CSS/eligibilityCheck.css" rel="stylesheet" />


<div class="as-wrap">

    <!-- ================= REGISTRATION FORM (direct, no list) ================= -->
    <div class="as-card as-wizard-card" id="srFormWrap">
        <div class="as-back-row">
            <a class="as-back-link" href="@Url.Action("Application", "Admission")"><i class="fas fa-arrow-left"></i> Back to Application Management</a>
        </div>
        <div class="as-body">
            <div class="as-page active">
                <div class="as-head">
                    <div class="as-icon"><i class="fas fa-user-plus"></i></div>
                    <div>
                        <h2>Student Registration <span style="font-size:12px; color:#7C5CFC; font-weight:700;">STEP 3</span></h2>
                        <p>Course dropdown comes from <strong>Admission Setup</strong>. Saving here creates an Application that flows to Application Management.</p>
                    </div>
                </div>

                <div class="as-section-title"><i class="fas fa-user"></i> Personal Details</div>
                <div class="as-grid">
                    <div class="as-field">
                        <label>Full Name <span class="req">*</span></label>
                        <input type="text" id="srName" placeholder="e.g. Rohit Sharma">
                    </div>
                    <div class="as-field">
                        <label>Email <span class="req">*</span></label>
                        <input type="email" id="srEmail" placeholder="e.g. rohit@example.com">
                    </div>
                    <div class="as-field">
                        <label>Phone <span class="req">*</span></label>
                        <input type="text" id="srPhone" placeholder="e.g. 9876543210" maxlength="10" inputmode="numeric" oninput="srValidatePhoneInput(this)">
                        <span class="as-hint">10 digit mobile number, numbers only</span>
                    </div>
                    <div class="as-field">
                        <label>Date of Birth</label>
                        <input type="date" id="srDob">
                    </div>
                    <div class="as-field">
                        <label>Gender</label>
                        <select id="srGender">
                            <option value="Male">Male</option>
                            <option value="Female">Female</option>
                            <option value="Other">Other</option>
                        </select>
                    </div>
                </div>

                <div class="as-section-title"><i class="fas fa-layer-group"></i> Category &amp; Admission Type</div>
                <div class="as-grid">
                    <div class="as-field">
                        <label>Cast Category <span class="req">*</span></label>
                        <select id="srCategory">
                            <option value="">-- Select Category --</option>
                            @foreach (var c in categories)
                            {
                                <option value="@c.CategoryId">@c.CategoryName</option>
                            }
                        </select>
                        <span class="as-hint">From Category Master</span>
                    </div>
                    <div class="as-field">
                        <label>Admission Type / Mode <span class="req">*</span></label>
                        <select id="srAdmissionMode">
                            <option value="">-- Select Admission Mode --</option>
                            @foreach (var m in admissionModes)
                            {
                                <option value="@m.AdmissionModeId">@m.AdmissionModeName</option>
                            }
                        </select>
                        <span class="as-hint">From Admission Mode Master</span>
                    </div>
                </div>

                <div class="as-section-title"><i class="fas fa-book"></i> Course Details</div>
                <div class="as-grid">
                    <div class="as-field">
                        <label>Course <span class="req">*</span></label>
                        <select id="srCourse">
                            <option value="">-- Select Course --</option>
                            @foreach (var s in openSetups)
                            {
                                <option value="@s.AdmissionSetupId">@s.CourseName (@s.SessionName)</option>
                            }
                        </select>
                        <span class="as-hint">Only courses "Open" in Admission Setup appear here</span>
                    </div>
                    <div class="as-field">
                        <label>Previous Percentage</label>
                        <input type="number" id="srPct" min="0" max="100" step="0.01" placeholder="e.g. 62">
                    </div>
                </div>

                <div class="as-bar">
                    <a class="as-btn as-btn-ghost" href="@Url.Action("Application", "Admission")">Cancel</a>
                    <span></span>
                    <button type="button" class="as-btn as-btn-primary" onclick="srSave()"><i class="fas fa-save"></i> Submit Registration</button>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="as-toast" id="srToast"><i class="fas fa-check-circle"></i><span id="srToastMessage">Success!</span></div>

<script>
    function srShowToast(msg, type) {
        const toast = document.getElementById('srToast');
        toast.querySelector('span').textContent = msg;
        toast.className = 'as-toast show ' + (type || '');
        setTimeout(() => toast.classList.remove('show'), 3000);
    }

    // ----- Phone: allow only digits while typing, max 10 -----
    function srValidatePhoneInput(input) {
        input.value = input.value.replace(/[^0-9]/g, '').slice(0, 10);
    }

    // ----- Save (AJAX -> Controller -> sp_Application INSERT) -----
    function srSave() {
        const name = document.getElementById('srName').value.trim();
        if (!name) { srShowToast('Full Name is required', 'error'); return; }
        const email = document.getElementById('srEmail').value.trim();
        if (!email) { srShowToast('Email is required', 'error'); return; }
        const phone = document.getElementById('srPhone').value.trim();
        if (!phone) { srShowToast('Phone is required', 'error'); return; }
        if (!/^[0-9]{10}$/.test(phone)) { srShowToast('Phone number must be exactly 10 digits', 'error'); return; }
        const categoryId = document.getElementById('srCategory').value;
        if (!categoryId) { srShowToast('Please select a Cast Category', 'error'); return; }
        const admissionModeId = document.getElementById('srAdmissionMode').value;
        if (!admissionModeId) { srShowToast('Please select an Admission Mode', 'error'); return; }
        const admissionSetupId = document.getElementById('srCourse').value;
        if (!admissionSetupId) { srShowToast('Please select a Course', 'error'); return; }

        const payload = {
            FullName: name,
            Email: email,
            Phone: phone,
            DOB: document.getElementById('srDob').value || null,
            Gender: document.getElementById('srGender').value,
            CategoryId: parseInt(categoryId),
            AdmissionModeId: parseInt(admissionModeId),
            AdmissionSetupId: parseInt(admissionSetupId),
            PreviousPercentage: document.getElementById('srPct').value || null
        };

        fetch('/Admission/RegisterApplication', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload)
        })
            .then(res => res.json())
            .then(data => {
                if (!data.success) { srShowToast(data.message, 'error'); return; }
                srShowToast(data.message, 'success');
                setTimeout(() => window.location.href = '/Admission/Application', 1000);
            })
            .catch(() => srShowToast('Server error while registering application', 'error'));
    }

    // Prefill from Eligibility Check (via query string), if present
    function srPrefillFromQuery() {
        const params = new URLSearchParams(window.location.search);
        if (params.get('name')) {
            document.getElementById('srName').value = params.get('name') || '';
            document.getElementById('srPct').value = params.get('pct') || '';
        }
    }

    srPrefillFromQuery();
</script>