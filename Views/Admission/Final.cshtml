@using Regis.Models
@{
    ViewBag.Title = "Final";
    Layout = "~/Views/Shared/_mainLayout.cshtml";
    var pending = ViewBag.PendingFinal as List<ApplicationModel> ?? new List<ApplicationModel>();
    var app = ViewBag.App as ApplicationModel;
    int? appId = ViewBag.AppId;
}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<link href="~/Content/CSS/academicSession.css" rel="stylesheet" />
<link href="~/Content/CSS/eligibilityCheck.css" rel="stylesheet" />

<div class="as-wrap">

    @if (!appId.HasValue)
    {
        <!-- ================= LIST MODE ================= -->
        <div class="as-card">
            <div class="as-list-head">
                <div>
                    <h2><i class="fas fa-graduation-cap"></i> Admission (Final) <span style="font-size:12px; color:#7C5CFC; font-weight:700;">STEP 8</span></h2>
                    <p>Only applications with <strong>fee paid</strong> appear here. Confirming here creates the Student record.</p>
                </div>
            </div>
            <div class="as-table-wrapper">
                <table class="as-table as-list-table">
                    <thead><tr><th>Application No.</th><th>Name</th><th>Course</th><th>Seat No.</th><th>Fee Receipt</th><th>Status</th><th>Actions</th></tr></thead>
                    <tbody>
                        @if (pending.Count == 0)
                        {
                            <tr><td colspan="7" style="text-align:center; color:#6B7A99;">No applications ready for final admission yet</td></tr>
                        }
                        else
                        {
                            foreach (var a in pending)
                            {
                                <tr>
                                    <td>@a.ApplicationNo</td>
                                    <td><strong>@a.FullName</strong></td>
                                    <td>@a.CourseName</td>
                                    <td>@(a.SeatNumber ?? "—")</td>
                                    <td>@(a.FeeReceiptNo ?? "—")</td>
                                    <td><span class="as-pill as-pill-locked"><i class="fas fa-check-circle"></i> Fee Paid</span></td>
                                    <td><a class="as-btn as-btn-primary as-btn-sm" href="@Url.Action("Final", "Admission", new { appId = a.ApplicationId })">Confirm</a></td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
    else if (app != null && app.StudentId != null)
    {
        <!-- ================= DONE STATE (already confirmed) ================= -->
        <div class="as-card as-wizard-card">
            <div class="as-body">
                <div class="as-page active">
                    <div class="as-done">
                        <div class="as-done-icon"><i class="fas fa-check-circle"></i></div>
                        <h2>Admission Confirmed!</h2>
                        <p><strong>@app.FullName</strong> has been admitted to <strong>@app.CourseName</strong>.<br />Student ID: <strong>@app.StudentId</strong></p>
                        <div class="as-done-actions">
                            <a class="as-btn as-btn-primary" href="@Url.Action("Application", "Admission")"><i class="fas fa-list"></i> Back to Applications</a>
                            <a class="as-btn as-btn-outline" href="@Url.Action("AdmissionSetup", "Admission")"><i class="fas fa-plus-circle"></i> Start Another Admission</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <!-- ================= CONFIRMATION MODE ================= -->
        <div class="as-card as-wizard-card">
            <div class="as-back-row">
                <a class="as-back-link" href="@Url.Action("Application", "Admission")"><i class="fas fa-arrow-left"></i> Back to Application Management</a>
            </div>
            <div class="as-body">
                <div class="as-page active">
                    <div class="as-head">
                        <div class="as-icon"><i class="fas fa-graduation-cap"></i></div>
                        <div>
                            <h2>Confirm Final Admission</h2>
                            <p>Application @(app != null ? app.ApplicationNo : "—")</p>
                        </div>
                    </div>

                    <div class="as-section-title"><i class="fas fa-clipboard-check"></i> Application Summary</div>
                    <div class="as-grid">
                        <div class="as-field"><label>Name</label><input type="text" value="@(app != null ? app.FullName : "—")" readonly disabled></div>
                        <div class="as-field"><label>Course</label><input type="text" value="@(app != null ? app.CourseName : "—")" readonly disabled></div>
                        <div class="as-field"><label>Category</label><input type="text" value="@(app != null ? app.CategoryName : "—")" readonly disabled></div>
                        <div class="as-field"><label>Seat No.</label><input type="text" value="@(app != null ? app.SeatNumber : "—")" readonly disabled></div>
                        <div class="as-field"><label>Fee Receipt</label><input type="text" value="@(app != null ? app.FeeReceiptNo : "—")" readonly disabled></div>
                        <div class="as-field"><label>Documents</label><input type="text" value="All Verified ✓" readonly disabled></div>
                    </div>

                    <div class="as-warning-box">
                        <i class="fas fa-exclamation-triangle"></i>
                        <div><strong>This action cannot be undone.</strong> Confirming will generate a permanent Student ID and move this record to Student Master.</div>
                    </div>

                    <div class="as-bar">
                        <a class="as-btn as-btn-ghost" href="@Url.Action("Application", "Admission")">Cancel</a>
                        <span></span>
                        <button class="as-btn as-btn-primary" onclick="afConfirm()"><i class="fas fa-check-circle"></i> Confirm Admission</button>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<div class="as-toast" id="afToast"><i class="fas fa-check-circle"></i><span id="afToastMessage">Success!</span></div>

<script>
    function afShowToast(msg, type) {
        const toast = document.getElementById('afToast');
        toast.querySelector('span').textContent = msg;
        toast.className = 'as-toast show ' + (type || '');
        setTimeout(() => toast.classList.remove('show'), 3000);
    }

    // ----- Confirm Admission (AJAX -> Controller -> sp_Application CONFIRMADMISSION) -----
    function afConfirm() {
        const applicationId = @(appId ?? 0);

        fetch('@Url.Action("ConfirmAdmission", "Admission")', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: 'applicationId=' + applicationId
        })
            .then(res => res.json())
            .then(data => {
                if (!data.success) { afShowToast(data.message, 'error'); return; }
                afShowToast(data.message, 'success');
                // reload so the page re-renders in the "Done" state via ViewBag.App.StudentId
                setTimeout(() => window.location.reload(), 1000);
            })
            .catch(() => afShowToast('Server error while confirming admission', 'error'));
    }
</script>
