@* Views/Account/Login.cshtml *@
@model Regis.Models.LoginModel
@{
    ViewBag.Title = "Registrar Login";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Office of the Registrar — Sign In</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link href="~/Content/CSS/academicSession.css" rel="stylesheet" />
    <style>
        :root {
            --navy-900: #0a1a33;
            --navy-800: #0f2447;
            --navy-600: #16305c;
            --gold: #c9a545;
            --gold-soft: #e7d8a8;
            --paper: #f6f7fb;
            --ink: #1b2434;
            --muted: #8791a3;
            --line: #e4e8f1;
            --error-bg: #fdeeee;
            --error-text: #9c2b2b;
        }

        * {
            box-sizing: border-box;
        }

        html, body {
            height: 100%;
            margin: 0;
        }

        body {
            font-family: 'Inter', sans-serif;
            color: var(--ink);
            background: var(--paper);
            display: grid;
            grid-template-columns: 1fr 1fr;
            min-height: 100vh;
        }

        /* ============== LEFT — institutional panel with video ============== */
        .rl-brand {
            position: relative;
            color: #fff;
            padding: 56px 64px;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            overflow: hidden;
            background: var(--navy-900);
        }

        .rl-video {
            position: absolute;
            inset: 0;
            width: 100%;
            height: 100%;
            object-fit: cover;
            z-index: 0;
            opacity: 0;
            transition: opacity 1.2s ease;
        }

            .rl-video.is-active {
                opacity: 1;
            }

        /* dark navy + gold wash over the footage so text stays legible and on-brand */
        .rl-video-overlay {
            position: absolute;
            inset: 0;
            z-index: 1;
            background: linear-gradient(160deg, rgba(10,26,51,0.92) 0%, rgba(15,36,71,0.82) 52%, rgba(22,48,92,0.78) 100%);
            pointer-events: none;
        }

            /* faint ruled-ledger lines — nods to student records / registrar's own paper trail */
            .rl-video-overlay::before {
                content: "";
                position: absolute;
                inset: 0;
                background-image: repeating-linear-gradient( to bottom, transparent 0 39px, rgba(255,255,255,0.05) 39px 40px );
                pointer-events: none;
            }

            .rl-video-overlay::after {
                content: "";
                position: absolute;
                right: -180px;
                top: -180px;
                width: 480px;
                height: 480px;
                border-radius: 50%;
                border: 1px solid rgba(201,165,69,0.22);
                pointer-events: none;
            }

        .rl-brand-top {
            position: relative;
            z-index: 2;
        }

        .rl-crest-row {
            display: flex;
            align-items: center;
            gap: 16px;
        }

        .rl-crest {
            width: 52px;
            height: 52px;
            flex-shrink: 0;
        }

        .rl-inst-name {
            font-family: 'Fraunces', serif;
            font-size: 1.05rem;
            font-weight: 600;
            letter-spacing: 0.01em;
            line-height: 1.25;
        }

        .rl-inst-sub {
            font-size: 0.68rem;
            letter-spacing: 0.14em;
            text-transform: uppercase;
            color: var(--gold-soft);
            margin-top: 3px;
        }

        .rl-quote-block {
            position: relative;
            z-index: 2;
            max-width: 460px;
            margin-top: 64px;
        }

        .rl-eyebrow {
            font-size: 0.7rem;
            letter-spacing: 0.16em;
            text-transform: uppercase;
            color: var(--gold);
            font-weight: 700;
            margin-bottom: 18px;
        }

        .rl-headline {
            font-family: 'Fraunces', serif;
            font-size: 2.3rem;
            line-height: 1.22;
            font-weight: 600;
            margin: 0 0 16px;
        }

            .rl-headline em {
                font-style: italic;
                color: var(--gold-soft);
            }

        .rl-sub {
            font-size: 0.92rem;
            line-height: 1.65;
            color: rgba(255,255,255,0.72);
            max-width: 400px;
        }

        .rl-brand-bottom {
            position: relative;
            z-index: 2;
            display: flex;
            gap: 36px;
            border-top: 1px solid rgba(255,255,255,0.14);
            padding-top: 22px;
        }

        .rl-stat-num {
            font-family: 'Fraunces', serif;
            font-size: 1.15rem;
            font-weight: 600;
            color: var(--gold-soft);
        }

        .rl-stat-label {
            font-size: 0.68rem;
            color: rgba(255,255,255,0.55);
            letter-spacing: 0.04em;
            margin-top: 2px;
        }

        /* ============== RIGHT — sign-in panel (unchanged) ============== */
        .rl-panel {
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 40px 32px;
            background: #fff;
        }

        .rl-form-wrap {
            width: 100%;
            max-width: 340px;
        }

        .rl-form-head {
            margin-bottom: 30px;
        }

        .rl-form-eyebrow {
            font-size: 0.7rem;
            letter-spacing: 0.14em;
            text-transform: uppercase;
            color: var(--muted);
            font-weight: 700;
            margin-bottom: 8px;
        }

        .rl-form-title {
            font-family: 'Fraunces', serif;
            font-size: 1.6rem;
            font-weight: 600;
            color: var(--navy-900);
            margin: 0;
        }

        .rl-form-desc {
            font-size: 0.82rem;
            color: var(--muted);
            margin-top: 8px;
            line-height: 1.5;
        }

        .rl-error {
            display: flex;
            align-items: flex-start;
            gap: 8px;
            background: var(--error-bg);
            color: var(--error-text);
            padding: 11px 13px;
            border-radius: 8px;
            font-size: 0.82rem;
            margin-bottom: 20px;
            border-left: 3px solid var(--error-text);
        }

        .rl-field {
            margin-bottom: 18px;
        }

            .rl-field label {
                display: block;
                font-size: 0.72rem;
                font-weight: 700;
                color: var(--navy-800);
                letter-spacing: 0.03em;
                text-transform: uppercase;
                margin-bottom: 7px;
            }

        .rl-input-wrap {
            position: relative;
        }

            .rl-input-wrap svg {
                position: absolute;
                left: 13px;
                top: 50%;
                transform: translateY(-50%);
                width: 16px;
                height: 16px;
                color: var(--muted);
                pointer-events: none;
            }

        .rl-field input {
            width: 100%;
            padding: 0.72rem 0.9rem 0.72rem 2.4rem;
            border: 1.5px solid var(--line);
            border-radius: 9px;
            font-size: 0.9rem;
            font-family: 'Inter', sans-serif;
            color: var(--ink);
            background: var(--paper);
            outline: none;
            transition: border-color .15s ease, background .15s ease, box-shadow .15s ease;
        }

            .rl-field input:focus {
                border-color: var(--navy-600);
                background: #fff;
                box-shadow: 0 0 0 3px rgba(22,48,92,0.10);
            }

        .rl-submit {
            width: 100%;
            padding: 0.78rem;
            margin-top: 6px;
            background: var(--navy-800);
            background-image: linear-gradient(135deg, var(--navy-600), var(--navy-900));
            color: #fff;
            border: none;
            border-radius: 9px;
            font-family: 'Inter', sans-serif;
            font-weight: 700;
            font-size: 0.88rem;
            letter-spacing: 0.01em;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            transition: filter .15s ease, transform .05s ease;
        }

            .rl-submit:hover {
                filter: brightness(1.08);
            }

            .rl-submit:active {
                transform: translateY(1px);
            }

        .rl-footnote {
            text-align: center;
            font-size: 0.72rem;
            color: var(--muted);
            margin-top: 26px;
        }

        /* focus visibility for keyboard users */
        a:focus-visible, button:focus-visible, input:focus-visible {
            outline: 2px solid var(--gold);
            outline-offset: 2px;
        }

        @@media (max-width: 900px) {
            body {
                grid-template-columns: 1fr;
            }

            .rl-brand {
                padding: 34px 28px;
                min-height: 220px;
            }

            .rl-quote-block {
                margin-top: 28px;
            }

            .rl-headline {
                font-size: 1.5rem;
            }

            .rl-sub {
                display: none;
            }

            .rl-brand-bottom {
                display: none;
            }

            .rl-panel {
                padding: 32px 24px;
            }
        }

        @@media (prefers-reduced-motion: reduce) {
            .rl-submit {
                transition: none;
            }

            .rl-video {
                display: none;
            }
        }
    </style>
</head>
<body>

    <!-- ============== LEFT PANEL — video background ============== -->
    <div class="rl-brand">

        <video id="rlVideoA" class="rl-video is-active" muted loop playsinline autoplay
               poster="https://assets.mixkit.co/videos/4519/4519-thumb-720-0.jpg"
               src="https://assets.mixkit.co/videos/4519/4519-720.mp4"></video>
        <video id="rlVideoB" class="rl-video" muted loop playsinline></video>
        <div class="rl-video-overlay"></div>

        <div class="rl-brand-top">
            <div class="rl-crest-row">
                <svg class="rl-crest" viewBox="0 0 52 52" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <circle cx="26" cy="26" r="24.5" stroke="#c9a545" stroke-width="1.2" />
                    <circle cx="26" cy="26" r="19.5" stroke="#c9a545" stroke-width="0.6" opacity="0.6" />
                    <path d="M26 14 L34 19 V29 C34 35 30.5 38.5 26 40 C21.5 38.5 18 35 18 29 V19 Z"
                          stroke="#e7d8a8" stroke-width="1.3" fill="none" stroke-linejoin="round" />
                    <path d="M22 25 L25 28 L31 21" stroke="#e7d8a8" stroke-width="1.4" fill="none"
                          stroke-linecap="round" stroke-linejoin="round" />
                </svg>
                <div>
                    <div class="rl-inst-name">University Registrar</div>
                    <div class="rl-inst-sub">Office of Student Records</div>
                </div>
            </div>

            <div class="rl-quote-block">
                <div class="rl-eyebrow">Registrar Portal</div>
                <h1 class="rl-headline">Every student record,<br /><em>one office of record.</em></h1>
                <p class="rl-sub">Sign in to review admissions, verify documents, and manage the official student file — access is limited to authorized Registrar staff.</p>
            </div>
        </div>

        <div class="rl-brand-bottom">
            <div>
                <div class="rl-stat-num">Secure</div>
                <div class="rl-stat-label">Session-authenticated access</div>
            </div>
            <div>
                <div class="rl-stat-num">Records</div>
                <div class="rl-stat-label">Admissions · Fees · Documents</div>
            </div>
        </div>
    </div>

    <!-- ============== RIGHT PANEL — FORM (unchanged) ============== -->
    <div class="rl-panel">
        <div class="rl-form-wrap">
            <div class="rl-form-head">
                <div class="rl-form-eyebrow">Staff Sign In</div>
                <h2 class="rl-form-title">Welcome back</h2>
                <p class="rl-form-desc">Enter your Registrar credentials to continue to the dashboard.</p>
            </div>

            @if (TempData["Error"] != null)
            {
                <div class="rl-error">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" style="margin-top:2px;flex-shrink:0;">
                        <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="2" />
                        <path d="M12 8v5" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
                        <circle cx="12" cy="16" r="1" fill="currentColor" />
                    </svg>
                    <span>@TempData["Error"]</span>
                </div>
            }

            @using (Html.BeginForm("Login", "Account", FormMethod.Post))
            {
                <div class="rl-field">
                    <label for="Username">Username</label>
                    <div class="rl-input-wrap">
                        <svg viewBox="0 0 24 24" fill="none"><path d="M12 12a4 4 0 100-8 4 4 0 000 8zM4 21c1.6-4 5-6 8-6s6.4 2 8 6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
                        @Html.TextBoxFor(m => m.Username, new { placeholder = "e.g. registrar.admin", autocomplete = "username", autofocus = "autofocus" })
                    </div>
                </div>

                <div class="rl-field">
                    <label for="Password">Password</label>
                    <div class="rl-input-wrap">
                        <svg viewBox="0 0 24 24" fill="none"><rect x="5" y="11" width="14" height="9" rx="2" stroke="currentColor" stroke-width="1.8" /><path d="M8 11V7a4 4 0 118 0v4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" /></svg>
                        @Html.PasswordFor(m => m.Password, new { placeholder = "Enter password", autocomplete = "current-password" })
                    </div>
                </div>

                <button type="submit" class="rl-submit">
                    Sign In
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none"><path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
                </button>
            }

            <p class="rl-footnote">Access restricted to authorized Registrar office personnel.</p>
        </div>
    </div>

    <script>(function () {
            var clips = [
                "https://assets.mixkit.co/videos/4519/4519-720.mp4",
                "https://assets.mixkit.co/videos/4520/4520-720.mp4",
                "https://assets.mixkit.co/videos/4560/4560-720.mp4",
                "https://assets.mixkit.co/videos/4566/4566-720.mp4"
            ];
            var videoA = document.getElementById("rlVideoA");
            var videoB = document.getElementById("rlVideoB");
            var current = 0;
            var showingA = true;
            var ROTATE_MS = 7000;

            function playNext() {
                current = (current + 1) % clips.length;
                var incoming = showingA ? videoB : videoA;
                var outgoing = showingA ? videoA : videoB;

                incoming.src = clips[current];
                incoming.load();
                incoming.play().catch(function () {});

                incoming.classList.add("is-active");
                outgoing.classList.remove("is-active");

                showingA = !showingA;
            }

            if (videoA && videoB) {
                setInterval(playNext, ROTATE_MS);
            }
        })();</script>

</body>
</html>
