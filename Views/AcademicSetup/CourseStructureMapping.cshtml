@model List<Regis.Models.CourseStructureMappingModel>
@using Regis.Models

@{
    ViewBag.Title = "CourseStructureMapping";
    Layout = "~/Views/Shared/_mainLayout.cshtml";
    var courses = ViewBag.Courses as List<CourseMasterModel> ?? new List<CourseMasterModel>();
}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<link href="~/Content/CSS/academicSession.css" rel="stylesheet" />

@if (TempData["Error"] != null)
{
    <div style="background:#fee; color:#900; padding:10px; margin:10px 0; border:1px solid #900;">@TempData["Error"]</div>
}
@if (TempData["Success"] != null)
{
    <div style="background:#efe; color:#060; padding:10px; margin:10px 0; border:1px solid #060;">@TempData["Success"]</div>
}
<link href="~/Content/CSS/coursestylemapping.css" rel="stylesheet" />

<div class="as-wrap">

    <!-- ================= FILTER BAR (list ke upar — original, unchanged) ================= -->
    <div class="csm-filter-card" id="csmFilterBar">
        <div class="csm-filter-row">
            <div class="csm-filter-field">
                <label>Course</label>
                <select id="filterCourseId" onchange="csmFilterOnCourseChange()">
                    <option value="">All Courses</option>
                    @foreach (var c in courses)
                    {
                        <option value="@c.CourseId">@c.CourseName</option>
                    }
                </select>
            </div>
            <div class="csm-filter-field">
                <label>Branch</label>
                <select id="filterBranchId" onchange="csmApplyFilter()" disabled>
                    <option value="">All Branches</option>
                </select>
            </div>
            <div class="csm-filter-field">
                <label>Semester</label>
                <select id="filterSemesterNumber" onchange="csmApplyFilter()" disabled>
                    <option value="">All Semesters</option>
                </select>
            </div>
        </div>
    </div>

    <!-- ================= LIST PAGE (Course sidebar + Branch/Semester detail) ================= -->
    <div class="as-card" id="csmListWrap">
        <div class="as-list-head">
            <div>
                <h2><i class="fas fa-sitemap"></i> Course Structure Mapping</h2>
                <p>Map each Course to its Branches and Semesters.</p>
            </div>
            <button class="as-btn as-btn-primary" onclick="csmShowForm()">
                <i class="fas fa-plus-circle"></i> Add New Mapping
            </button>
        </div>

        <div class="as-quick-stats">
            <div class="as-stat-card">
                <div class="as-stat-icon"><i class="fas fa-sitemap"></i></div>
                <div class="as-stat-info">
                    <span class="as-stat-number" id="csmTotalCount">@Model.Count</span>
                    <span class="as-stat-label">Total Mappings</span>
                </div>
            </div>
            <div class="as-stat-card active">
                <div class="as-stat-icon"><i class="fas fa-check-circle"></i></div>
                <div class="as-stat-info">
                    <span class="as-stat-number">@Model.Count(m => m.IsActive)</span>
                    <span class="as-stat-label">Active Mappings</span>
                </div>
            </div>
        </div>

        <div class="csm-shell">
            <!-- LEFT: Course list (each course shown only once) -->
            <div class="csm-course-panel">
                <div class="csm-panel-head">Courses</div>
                <div id="csmCourseList">
                    @foreach (var c in courses)
                    {
                        <div class="csm-course-item" data-courseid="@c.CourseId" onclick="csmSelectCourse(@c.CourseId, this)">
                            <span class="csm-dot"></span>
                            <span>@c.CourseName</span>
                        </div>
                    }
                </div>
            </div>

            <!-- RIGHT: Branch/Semester rows for the selected course only -->
            <div class="csm-detail-panel">
                <div class="csm-detail-head">
                    <h3 id="csmDetailTitle">Course: <span>-- none selected --</span></h3>
                    <button type="button" class="csm-add-branch-btn" id="csmAddBranchBtn" style="display:none;" onclick="csmShowForm(null, csmSelectedCourseId)">
                        <i class="fas fa-plus"></i> Add Branch
                    </button>
                </div>

                <div class="csm-empty-state" id="csmEmptyState">
                    Select a Course from the list to view its Branches and Semesters.
                </div>

                <div class="csm-detail-table-wrap" id="csmDetailTableWrap" style="display:none;">
                    <table class="csm-detail-table">
                        <thead>
                            <tr>
                                <th>Branch</th>
                                <th>Semesters</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody id="csmTableBody">
                            @foreach (var m in Model)
                            {
                                <tr data-courseid="@m.CourseId" data-branchid="@m.BranchId" data-semester="@m.SemesterNumber" style="display:none;">
                                    <td><strong>@m.BranchName</strong></td>
                                    <td>Semester @m.SemesterNumber</td>
                                    <td>
                                        @if (m.IsActive)
                                        {
                                            <span class="as-pill as-pill-active"><i class="fas fa-circle"></i> Active</span>
                                        }
                                        else
                                        {
                                            <span class="as-pill as-pill-archived"><i class="fas fa-circle"></i> Inactive</span>
                                        }
                                    </td>
                                    <td>
                                        <button type="button" class="as-mini-btn" title="Edit" onclick="csmShowForm(this)"
                                                data-id="@m.MappingId" data-courseid="@m.CourseId"
                                                data-branchid="@m.BranchId" data-branchname="@m.BranchName"
                                                data-semester="@m.SemesterNumber" data-active="@m.IsActive.ToString().ToLower()">
                                            <i class="fas fa-edit"></i>
                                        </button>
                                        <a class="as-mini-btn" title="Delete"
                                           href="@Url.Action("DeleteCourseStructureMapping", "AcademicSetup", new { id = m.MappingId })"
                                           onclick="return confirm('Delete this mapping?');">
                                            <i class="fas fa-trash-alt"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    <p id="csmNoResults" style="display:none; text-align:center; padding:16px; color:#8a8f98;">No Branches mapped for this Course yet.</p>
                </div>
            </div>
        </div>

        <div class="as-legend">
            <span><span class="as-legend-dot active"></span> Active</span>
            <span><span class="as-legend-dot archived"></span> Inactive</span>
        </div>
    </div>

    <!-- ================= ADD / EDIT FORM (backend untouched) ================= -->
    @using (Html.BeginForm("CourseStructureMapping", "AcademicSetup", FormMethod.Post, new { id = "csmForm", onsubmit = "return csmValidateForm()" }))
    {
        <div class="as-card as-wizard-card" id="csmFormWrap" style="display:none;">

            <div class="as-back-row">
                <button type="button" class="as-back-link" onclick="csmShowList()">
                    <i class="fas fa-arrow-left"></i> Back to Mapping List
                </button>
            </div>

            <div class="as-body">
                <div class="as-page active">
                    <div class="as-head">
                        <div class="as-icon"><i class="fas fa-sitemap"></i></div>
                        <div>
                            <h2 id="csmFormTitle">Add Mapping</h2>
                            <p>Select Course first — Branch and Semester will unlock automatically.</p>
                        </div>
                    </div>

                    <div class="as-section-title"><i class="fas fa-info-circle"></i> Mapping Details</div>

                    <input type="hidden" id="mappingId" name="MappingId" value="0" />

                    <div class="as-grid">

                        <div class="as-field">
                            <label>Course <span class="req">*</span></label>
                            <select id="csmCourseId" name="CourseId" onchange="csmOnCourseChange()">
                                <option value="">-- Select Course --</option>
                                @foreach (var c in courses)
                                {
                                    <option value="@c.CourseId">@c.CourseName</option>
                                }
                            </select>
                            <span class="as-hint">Managed from Course Master</span>
                        </div>

                        <div class="as-field">
                            <label>Branch <span class="req">*</span></label>
                            <select id="csmBranchId" name="BranchId" disabled>
                                <option value="">-- Select Course First --</option>
                            </select>
                            <span class="as-hint">Filtered by selected Course's Department</span>
                        </div>

                        <div class="as-field">
                            <label>Semester <span class="req">*</span></label>
                            <select id="csmSemesterNumber" name="SemesterNumber" disabled>
                                <option value="">-- Select Course First --</option>
                            </select>
                            <span class="as-hint">Generated from Course's Total Semesters</span>
                        </div>

                        <div class="as-field">
                            <label>Status</label>
                            <select id="csmStatus" name="IsActive">
                                <option value="true">Active</option>
                                <option value="false">Inactive</option>
                            </select>
                        </div>
                    </div>

                    <div class="as-bar">
                        <button type="button" class="as-btn as-btn-ghost" onclick="csmShowList()">Cancel</button>
                        <span></span>
                        <button type="submit" class="as-btn as-btn-primary">
                            <i class="fas fa-save"></i> <span id="csmSubmitText">Save Mapping</span>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }

</div>

<script>
    var csmSelectedCourseId = null;

    // ============================================================
    // LEFT PANEL — Course click → filter right-side table (client side, no reload)
    // ============================================================
    function csmSelectCourse(courseId, el) {
        csmSelectedCourseId = String(courseId);

        // highlight active course in the list
        document.querySelectorAll('.csm-course-item').forEach(function (item) {
            item.classList.remove('active');
        });
        el.classList.add('active');

        // update detail header
        document.getElementById('csmDetailTitle').innerHTML = 'Course: <span>' + el.querySelector('span:last-child').textContent + '</span>';
        document.getElementById('csmAddBranchBtn').style.display = 'inline-block';

        // filter rows: only this course's Branch/Semester rows show
        var rows = document.querySelectorAll('#csmTableBody tr');
        var visibleCount = 0;
        rows.forEach(function (row) {
            if (row.dataset.courseid === csmSelectedCourseId) {
                row.style.display = '';
                visibleCount++;
            } else {
                row.style.display = 'none';
            }
        });

        document.getElementById('csmEmptyState').style.display = 'none';
        document.getElementById('csmDetailTableWrap').style.display = 'block';
        document.getElementById('csmNoResults').style.display = visibleCount === 0 ? 'block' : 'none';

        // keep the top filter bar in sync with the sidebar selection
        var topFilter = document.getElementById('filterCourseId');
        if (topFilter.value !== csmSelectedCourseId) {
            topFilter.value = csmSelectedCourseId;
            csmFilterOnCourseChange();
        }
    }

    // ============================================================
    // FORM (Add / Edit) — backend/action names unchanged
    // ============================================================
    function csmShowForm(btn, presetCourseId) {
        document.getElementById('csmFilterBar').style.display = 'none';
        document.getElementById('csmListWrap').style.display = 'none';
        document.getElementById('csmFormWrap').style.display = 'block';

        var branchSelect = document.getElementById('csmBranchId');
        var semesterSelect = document.getElementById('csmSemesterNumber');

        if (btn) {
            document.getElementById('csmFormTitle').textContent = 'Edit Mapping';
            document.getElementById('csmSubmitText').textContent = 'Update Mapping';

            document.getElementById('mappingId').value = btn.dataset.id;
            document.getElementById('csmCourseId').value = btn.dataset.courseid;
            document.getElementById('csmStatus').value = btn.dataset.active;

            csmLoadBranches(btn.dataset.courseid, btn.dataset.branchid);
            csmLoadSemesters(btn.dataset.courseid, btn.dataset.semester);
        } else {
            document.getElementById('csmFormTitle').textContent = 'Add Mapping';
            document.getElementById('csmSubmitText').textContent = 'Save Mapping';

            document.getElementById('mappingId').value = 0;
            document.getElementById('csmStatus').value = 'true';

            if (presetCourseId) {
                // "Add Branch" was clicked from a selected course's detail panel
                document.getElementById('csmCourseId').value = presetCourseId;
                csmLoadBranches(presetCourseId, null);
                csmLoadSemesters(presetCourseId, null);
            } else {
                document.getElementById('csmCourseId').value = '';
                branchSelect.innerHTML = '<option value="">-- Select Course First --</option>';
                branchSelect.disabled = true;
                semesterSelect.innerHTML = '<option value="">-- Select Course First --</option>';
                semesterSelect.disabled = true;
            }
        }
        window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    function csmShowList() {
        document.getElementById('csmFormWrap').style.display = 'none';
        document.getElementById('csmFilterBar').style.display = 'block';
        document.getElementById('csmListWrap').style.display = 'block';
        window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    function csmOnCourseChange() {
        var courseId = document.getElementById('csmCourseId').value;
        csmLoadBranches(courseId, null);
        csmLoadSemesters(courseId, null);
    }

    function csmLoadBranches(courseId, selectedBranchId, targetSelectId) {
        var branchSelect = document.getElementById(targetSelectId || 'csmBranchId');

        if (!courseId) {
            branchSelect.innerHTML = '<option value="">-- Select Course First --</option>';
            branchSelect.disabled = true;
            return;
        }

        branchSelect.disabled = false;
        branchSelect.innerHTML = '<option value="">Loading...</option>';

        fetch('@Url.Action("GetBranchesByCourse", "AcademicSetup")?courseId=' + courseId)
            .then(res => {
                if (!res.ok) throw new Error('Server error: ' + res.status);
                return res.json();
            })
            .then(data => {
                if (!data.length) {
                    branchSelect.innerHTML = '<option value="">-- No Branches Found --</option>';
                    return;
                }
                var options = '<option value="">-- Select Branch --</option>';
                data.forEach(function (b) {
                    options += '<option value="' + b.BranchId + '">' + b.BranchName + '</option>';
                });
                branchSelect.innerHTML = options;

                if (selectedBranchId) {
                    branchSelect.value = selectedBranchId;
                }
            })
            .catch(err => {
                console.error('Branch load failed:', err);
                branchSelect.innerHTML = '<option value="">-- Error loading branches --</option>';
            });
    }

    function csmLoadSemesters(courseId, selectedSemesterNumber, targetSelectId) {
        var semesterSelect = document.getElementById(targetSelectId || 'csmSemesterNumber');

        if (!courseId) {
            semesterSelect.innerHTML = '<option value="">-- Select Course First --</option>';
            semesterSelect.disabled = true;
            return;
        }

        semesterSelect.disabled = false;
        semesterSelect.innerHTML = '<option value="">Loading...</option>';

        fetch('@Url.Action("GetSemesterNumbersByCourse", "AcademicSetup")?courseId=' + courseId)
            .then(res => {
                if (!res.ok) throw new Error('Server error: ' + res.status);
                return res.json();
            })
            .then(data => {
                if (!data.length) {
                    semesterSelect.innerHTML = '<option value="">-- No Semesters Defined --</option>';
                    return;
                }
                var options = '<option value="">-- Select Semester --</option>';
                data.forEach(function (s) {
                    options += '<option value="' + s.SemesterNumber + '">' + s.SemesterLabel + '</option>';
                });
                semesterSelect.innerHTML = options;

                if (selectedSemesterNumber) {
                    semesterSelect.value = selectedSemesterNumber;
                }
            })
            .catch(err => {
                console.error('Semester load failed:', err);
                semesterSelect.innerHTML = '<option value="">-- Error loading semesters --</option>';
            });
    }

    function csmValidateForm() {
        var courseId = document.getElementById('csmCourseId').value;
        var branchId = document.getElementById('csmBranchId').value;
        var semesterNumber = document.getElementById('csmSemesterNumber').value;

        if (!courseId || !branchId || !semesterNumber) {
            alert('Course, Branch and Semester must all be selected.');
            return false;
        }
        return true;
    }

    // =========================================================================================
    // FILTER BAR (list ke upar) — cascading, sidebar aur table dono ko filter/select karta hai
    // =========================================================================================
    function csmFilterOnCourseChange() {
        var courseId = document.getElementById('filterCourseId').value;
        var branchSelect = document.getElementById('filterBranchId');
        var semesterSelect = document.getElementById('filterSemesterNumber');

        branchSelect.innerHTML = '<option value="">All Branches</option>';
        semesterSelect.innerHTML = '<option value="">All Semesters</option>';

        if (!courseId) {
            branchSelect.disabled = true;
            semesterSelect.disabled = true;

            document.querySelectorAll('.csm-course-item').forEach(function (item) {
                item.classList.remove('active');
            });
            csmSelectedCourseId = null;
            document.getElementById('csmDetailTitle').innerHTML = 'Course: <span>-- none selected --</span>';
            document.getElementById('csmAddBranchBtn').style.display = 'none';
            document.getElementById('csmEmptyState').style.display = 'flex';
            document.getElementById('csmDetailTableWrap').style.display = 'none';
            return;
        }

        csmLoadBranches(courseId, null, 'filterBranchId');
        csmLoadSemesters(courseId, null, 'filterSemesterNumber');

        // keep the sidebar in sync with the top filter's course selection
        var sidebarItem = document.querySelector('.csm-course-item[data-courseid="' + courseId + '"]');
        if (sidebarItem) {
            csmSelectCourse(courseId, sidebarItem);
        }
    }

    function csmApplyFilter() {
        var branchId = document.getElementById('filterBranchId').value;
        var semesterNumber = document.getElementById('filterSemesterNumber').value;

        var rows = document.querySelectorAll('#csmTableBody tr');
        var visibleCount = 0;

        rows.forEach(function (row) {
            var matchCourse = !csmSelectedCourseId || row.dataset.courseid === csmSelectedCourseId;
            var matchBranch = !branchId || row.dataset.branchid === branchId;
            var matchSemester = !semesterNumber || row.dataset.semester === semesterNumber;

            if (matchCourse && matchBranch && matchSemester) {
                row.style.display = '';
                visibleCount++;
            } else {
                row.style.display = 'none';
            }
        });

        document.getElementById('csmNoResults').style.display = visibleCount === 0 ? 'block' : 'none';
    }
</script>
