@{
    ViewBag.Title = "Dashboard";
    Layout = "~/Views/Shared/_mainLayout.cshtml";
}


<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
<link href="~/Content/CSS/dasboard.css" rel="stylesheet" />

<style>
    /* stat-card ab <a> tag hai, isliye link ke default styles neutralize kar rahe hain */
    a.stat-card {
        text-decoration: none;
        color: inherit;
        cursor: pointer;
        transition: transform 0.12s ease, box-shadow 0.12s ease;
    }

        a.stat-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 16px rgba(0,0,0,0.08);
        }
</style>

<div class="dash-wrap">

    <div class="d-flex justify-content-between align-items-end flex-wrap gap-2 mb-3">
        <div class="page-sub">Welcome back, here's what's happening today.</div>
        <div class="page-sub d-flex align-items-center gap-2">
            Session:
            <select id="sessionSwitch" class="session-select" onchange="showToast('Session changed to ' + this.value)">
                <option value="2025-26" selected>2025-26</option>
                <option value="2024-25">2024-25</option>
                <option value="2023-24">2023-24</option>
            </select>
        </div>
    </div>

    <!-- ============ SUMMARY CARDS (clickable) ============ -->
    <div class="row g-3 mb-3">
        <div class="col-6 col-md-4 col-xl-3">
            <a href="/StudentMaster/StudentRecords" class="stat-card">
                <div class="stat-icon" style="background:var(--primary-soft); color:var(--primary);"><i class="fa-solid fa-user-graduate"></i></div>
                <div>
                    <div class="stat-value" id="statTotalStudents">-</div>
                    <div class="stat-label">Total Students</div>
                </div>
            </a>
        </div>
        <div class="col-6 col-md-4 col-xl-3">
            <a href="/Admission/Application" class="stat-card">
                <div class="stat-icon" style="background:var(--success-soft); color:var(--success);"><i class="fa-solid fa-user-plus"></i></div>
                <div>
                    <div class="stat-value" id="statNewAdmissions">-</div>
                    <div class="stat-label">New Admissions</div>
                </div>
            </a>
        </div>
        <div class="col-6 col-md-4 col-xl-3">
            <a href="/Master/FacultyMaster" class="stat-card">
                <div class="stat-icon" style="background:var(--info-soft); color:var(--info);"><i class="fa-solid fa-chalkboard-user"></i></div>
                <div>
                    <div class="stat-value" id="statFaculty">-</div>
                    <div class="stat-label">Faculty Members</div>
                </div>
            </a>
        </div>
        <div class="col-6 col-md-4 col-xl-3">
            <a href="/Master/DepartmentMaster" class="stat-card">
                <div class="stat-icon" style="background:var(--warning-soft); color:var(--warning);"><i class="fa-solid fa-building-columns"></i></div>
                <div>
                    <div class="stat-value" id="statDepartments">-</div>
                    <div class="stat-label">Departments</div>
                </div>
            </a>
        </div>
        <div class="col-6 col-md-4 col-xl-3">
            <a href="/Master/CourseMaster" class="stat-card">
                <div class="stat-icon" style="background:var(--primary-soft); color:var(--primary);"><i class="fa-solid fa-book-open"></i></div>
                <div>
                    <div class="stat-value" id="statCourses">-</div>
                    <div class="stat-label">Courses</div>
                </div>
            </a>
        </div>
        <div class="col-6 col-md-4 col-xl-3">
            <a href="/Admission/FeePayment" class="stat-card">
                <div class="stat-icon" style="background:var(--success-soft); color:var(--success);"><i class="fa-solid fa-sack-dollar"></i></div>
                <div>
                    <div class="stat-value" id="statFeeCollected">-</div>
                    <div class="stat-label">Total Fee Collected</div>
                </div>
            </a>
        </div>
        <div class="col-6 col-md-4 col-xl-3">
            <a href="/Admission/FeePayment" class="stat-card">
                <div class="stat-icon" style="background:var(--danger-soft); color:var(--danger);"><i class="fa-solid fa-hourglass-half"></i></div>
                <div>
                    <div class="stat-value" id="statFeePending">-</div>
                    <div class="stat-label">Pending Fees</div>
                    <div class="stat-trend text-muted" id="statFeePendingCount"></div>
                </div>
            </a>
        </div>
        <div class="col-6 col-md-4 col-xl-3">
            <a href="/Admission/AdmissionSetup" class="stat-card">
                <div class="stat-icon" style="background:var(--info-soft); color:var(--info);"><i class="fa-solid fa-signal"></i></div>
                <div>
                    <div class="stat-value" id="statActiveSessions">-</div>
                    <div class="stat-label">Active Sessions</div>
                </div>
            </a>
        </div>
    </div>

    <!-- ============ CHARTS ROW 1 ============ -->
    <div class="row g-3 mb-3">
        <div class="col-12 col-xl-8">
            <div class="panel">
                <div class="panel-title">Admission Trend</div>
                <div class="panel-sub">Monthly new admissions — pulled from Application records</div>
                <div class="chart-wrap"><canvas id="admissionTrendChart"></canvas></div>
            </div>
        </div>
        <div class="col-12 col-xl-4">
            <div class="panel">
                <div class="panel-title">Student Category Distribution</div>
                <div class="panel-sub">By category — pulled from Student Records</div>
                <div class="chart-wrap"><canvas id="categoryPieChart"></canvas></div>
            </div>
        </div>
    </div>

    <!-- ============ CHARTS ROW 2 ============ -->
    <div class="row g-3 mb-3">
        <div class="col-12 col-xl-6">
            <div class="panel">
                <div class="panel-title">Fee Collection</div>
                <div class="panel-sub">Monthly collected — pulled from Application fee records (last 6 months)</div>
                <div class="chart-wrap sm"><canvas id="feeBarChart"></canvas></div>
            </div>
        </div>
        <div class="col-12 col-xl-6">
            <div class="panel">
                <div class="panel-title">Department-wise Students</div>
                <div class="panel-sub">Pulled from Student + Course + Department records</div>
                <div class="chart-wrap sm"><canvas id="deptDoughnutChart"></canvas></div>
            </div>
        </div>
    </div>

    <!-- ============ TABLE + NOTICES ============ -->
    <div class="row g-3 mb-3">
        <div class="col-12 col-xl-8">
            <div class="panel">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <div class="panel-title mb-0">Recent Admissions</div>
                    <a href="/Admission/Application" class="small fw-semibold text-decoration-none">View All →</a>
                </div>
                <div class="table-responsive">
                    <table class="table table-recent mb-0">
                        <thead>
                            <tr>
                                <th>Student</th>
                                <th>Course</th>
                                <th>Date</th>
                                <th>Fee Status</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody id="recentAdmissionsBody">
                            <tr><td colspan="5" class="text-center text-muted">Loading...</td></tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="col-12 col-xl-4">
            <div class="panel">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <div class="panel-title mb-0">Upcoming Events / Notices</div>
                    <a href="/Master/NoticeMaster" class="small fw-semibold text-decoration-none">Manage →</a>
                </div>
                <div id="noticesContainer">
                    <div class="text-muted small">Loading...</div>
                </div>
            </div>
        </div>
    </div>

    <!-- ============ ATTENDANCE + QUICK ACTIONS ============ -->
    <div class="row g-3">
        <div class="col-12 col-xl-4">
            <div class="panel">
                <div class="panel-title mb-3">Today's Attendance</div>

                <div class="attendance-row">
                    <div class="label-row"><span>Present</span><span class="text-success">86%</span></div>
                    <div class="progress"><div class="progress-bar bg-success" style="width:86%"></div></div>
                </div>
                <div class="attendance-row">
                    <div class="label-row"><span>Absent</span><span class="text-danger">9%</span></div>
                    <div class="progress"><div class="progress-bar bg-danger" style="width:9%"></div></div>
                </div>
                <div class="attendance-row mb-0">
                    <div class="label-row"><span>On Leave</span><span style="color:var(--warning);">5%</span></div>
                    <div class="progress"><div class="progress-bar" style="width:5%; background:var(--warning);"></div></div>
                </div>
            </div>
        </div>

        <div class="col-12 col-xl-8">
            <div class="panel">
                <div class="panel-title mb-3">Quick Actions</div>
                <div class="row g-2">
                    <div class="col-6 col-md-3">
                        <a href="/Admission/PersonalInformation" class="quick-btn"><i class="fa-solid fa-user-plus"></i><span>New Admission</span></a>
                    </div>
                    <div class="col-6 col-md-3">
                        <a href="/Admission/FeePayment" class="quick-btn"><i class="fa-solid fa-money-bill-wave"></i><span>Fee Collection</span></a>
                    </div>
                    <div class="col-6 col-md-3">
                        <a href="/StudentMaster/StudentRecords" class="quick-btn"><i class="fa-solid fa-magnifying-glass"></i><span>Student Search</span></a>
                    </div>
                    <div class="col-6 col-md-3">
                        <a href="/Reports/AdmissionReports" class="quick-btn"><i class="fa-solid fa-chart-column"></i><span>Reports</span></a>
                    </div>
                </div>
            </div>
        </div>
    </div>

</div>

<!-- Chhota toast, session change confirm karne ke liye -->
<div id="dashToast" class="dash-toast"></div>

<!-- Chart.js -->
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>
<script>
    function showToast(msg) {
        const t = document.getElementById('dashToast');
        t.textContent = msg;
        t.classList.add('show');
        setTimeout(() => t.classList.remove('show'), 2000);
    }

    // ASP.NET JSON date format ("/Date(1234567890)/") ko safely JS Date mein convert karta hai
    function parseAspDate(v) {
        if (!v) return null;
        var m = /\/Date\((\d+)\)\//.exec(v);
        var d = m ? new Date(parseInt(m[1])) : new Date(v);
        return isNaN(d.getTime()) ? null : d;
    }

    // ₹ ko compact form mein dikhane ke liye (Cr / L / K)
    function formatRupee(amount) {
        amount = amount || 0;
        if (amount >= 1e7) return '₹' + (amount / 1e7).toFixed(2) + 'Cr';
        if (amount >= 1e5) return '₹' + (amount / 1e5).toFixed(2) + 'L';
        if (amount >= 1e3) return '₹' + (amount / 1e3).toFixed(1) + 'K';
        return '₹' + amount.toFixed(0);
    }

    const monthShortNames = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];

    Chart.defaults.font.family = "'Inter', sans-serif";
    Chart.defaults.font.size = 11.5;
    Chart.defaults.color = '#6b7280';

    Promise.all([
        fetch('/Admission/GetAllApplicationsJson').then(r => r.json()).catch(() => []),
        fetch('/StudentMaster/GetAllStudentRecords').then(r => r.json()).catch(() => []),
        fetch('/Admission/GetAllAdmissionSetupsJson').then(r => r.json()).catch(() => []),
        fetch('/Admission/GetFeeSummaryJson').then(r => r.json()).catch(() => null),
        fetch('/Master/GetAllFacultyMasterJson').then(r => r.json()).catch(() => []),
        fetch('/Master/GetAllDepartmentMasterJson').then(r => r.json()).catch(() => []),
        fetch('/StudentMaster/GetDepartmentWiseCountsJson').then(r => r.json()).catch(() => []),
        fetch('/Master/GetAllCourseMasterJson').then(r => r.json()).catch(() => []),
        fetch('/Master/GetUpcomingNoticesJson').then(r => r.json()).catch(() => [])
    ]).then(([applications, students, setups, feeSummary, faculties, departments, deptCounts, courses, notices]) => {
        applications = applications || [];
        students = students || [];
        setups = setups || [];
        faculties = faculties || [];
        departments = departments || [];
        deptCounts = deptCounts || [];
        courses = courses || [];
        notices = notices || [];

        // ----- Summary cards -----
        document.getElementById('statTotalStudents').textContent = students.length;
        document.getElementById('statNewAdmissions').textContent = applications.length;
        document.getElementById('statActiveSessions').textContent = new Set(setups.filter(s => s.Status === 'Open').map(s => s.SessionName)).size || '1';

        // ----- Faculty / Department / Course cards (real data) -----
        document.getElementById('statFaculty').textContent = faculties.filter(f => f.IsActive).length;
        document.getElementById('statDepartments').textContent = departments.filter(d => d.IsActive).length;
        document.getElementById('statCourses').textContent = courses.filter(c => c.Status === 'Active').length;

        // ----- Fee cards (real data) -----
        if (feeSummary) {
            document.getElementById('statFeeCollected').textContent = formatRupee(feeSummary.TotalCollected);
            document.getElementById('statFeePending').textContent = formatRupee(feeSummary.EstimatedPendingAmount);
            document.getElementById('statFeePendingCount').textContent = feeSummary.PendingCount + ' application(s) pending';
        } else {
            document.getElementById('statFeeCollected').textContent = '₹0';
            document.getElementById('statFeePending').textContent = '₹0';
        }

        // ----- Fee Collection (BAR) — real month-wise data -----
        const feeMonths = (feeSummary && feeSummary.MonthlyCollection) ? feeSummary.MonthlyCollection : [];
        new Chart(document.getElementById('feeBarChart'), {
            type: 'bar',
            data: {
                labels: feeMonths.length ? feeMonths.map(m => m.MonthName) : ['No data'],
                datasets: [
                    { label: 'Collected', data: feeMonths.length ? feeMonths.map(m => m.Collected) : [0], backgroundColor: '#2563eb', borderRadius: 5, barPercentage: 0.6 }
                ]
            },
            options: {
                responsive: true, maintainAspectRatio: false,
                plugins: { legend: { position: 'bottom', labels: { boxWidth: 10, padding: 12 } } },
                scales: { y: { beginAtZero: true, grid: { color: '#f0f1f5' } }, x: { grid: { display: false } } }
            }
        });

        // ----- Admission Trend (line) — month-wise application count -----
        const byMonth = new Array(12).fill(0);
        applications.forEach(a => {
            const d = parseAspDate(a.RegisteredOn);
            if (d) byMonth[d.getMonth()]++;
        });

        new Chart(document.getElementById('admissionTrendChart'), {
            type: 'line',
            data: {
                labels: monthShortNames,
                datasets: [{
                    label: 'New Admissions',
                    data: byMonth,
                    borderColor: '#2563eb',
                    backgroundColor: 'rgba(37,99,235,0.08)',
                    fill: true, tension: 0.4, pointRadius: 3, pointBackgroundColor: '#2563eb'
                }]
            },
            options: {
                responsive: true, maintainAspectRatio: false,
                plugins: { legend: { display: false } },
                scales: { y: { beginAtZero: true, grid: { color: '#f0f1f5' } }, x: { grid: { display: false } } }
            }
        });

        // ----- Student Category Distribution (pie) -----
        const byCategory = {};
        students.forEach(s => { const c = s.Category || 'Unspecified'; byCategory[c] = (byCategory[c] || 0) + 1; });

        new Chart(document.getElementById('categoryPieChart'), {
            type: 'pie',
            data: {
                labels: Object.keys(byCategory),
                datasets: [{ data: Object.values(byCategory), backgroundColor: ['#2563eb', '#16a34a', '#d97706', '#0891b2', '#dc2626'], borderWidth: 2, borderColor: '#fff' }]
            },
            options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { position: 'bottom', labels: { boxWidth: 10, padding: 12 } } } }
        });

        // ----- Department-wise Students (DOUGHNUT) — real data -----
        const deptColors = ['#2563eb', '#0891b2', '#16a34a', '#d97706', '#7c3aed', '#dc2626', '#ca8a04', '#059669'];
        new Chart(document.getElementById('deptDoughnutChart'), {
            type: 'doughnut',
            data: {
                labels: deptCounts.length ? deptCounts.map(d => d.DepartmentName) : ['No data'],
                datasets: [{
                    data: deptCounts.length ? deptCounts.map(d => d.StudentCount) : [1],
                    backgroundColor: deptCounts.length ? deptColors.slice(0, deptCounts.length) : ['#e2e8f0'],
                    borderWidth: 2, borderColor: '#fff'
                }]
            },
            options: { responsive: true, maintainAspectRatio: false, cutout: '65%', plugins: { legend: { position: 'bottom', labels: { boxWidth: 10, padding: 12 } } } }
        });

        // ----- Recent Admissions table (latest 5) -----
        const recent = applications.slice().sort((a, b) => {
            const da = parseAspDate(a.RegisteredOn), db = parseAspDate(b.RegisteredOn);
            return (db ? db.getTime() : 0) - (da ? da.getTime() : 0);
        }).slice(0, 5);

        document.getElementById('recentAdmissionsBody').innerHTML = recent.map(a => {
            const initials = (a.FullName || '?').split(' ').map(w => w[0]).join('').substring(0, 2).toUpperCase();
            const feeStatus = a.FeePaid
                ? '<span class="status-pill" style="background:var(--success-soft); color:var(--success);">Paid</span>'
                : '<span class="status-pill" style="background:var(--danger-soft); color:var(--danger);">Unpaid</span>';
            const stagePill = '<span class="status-pill" style="background:var(--info-soft); color:var(--info);">' + (a.Stage || '') + '</span>';
            const regDate = parseAspDate(a.RegisteredOn);
            const regDateText = regDate ? regDate.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' }) : '-';
            return `<tr>
                <td class="d-flex align-items-center gap-2"><div class="avatar-sm">${initials}</div> ${a.FullName || ''}</td>
                <td>${a.CourseName || '-'}</td>
                <td>${regDateText}</td>
                <td>${feeStatus}</td>
                <td>${stagePill}</td>
            </tr>`;
        }).join('') || '<tr><td colspan="5" class="text-center text-muted">No admissions yet</td></tr>';

        // ----- Upcoming Events / Notices (real data) -----
        document.getElementById('noticesContainer').innerHTML = notices.length ? notices.map(n => {
            const d = parseAspDate(n.EventDate);
            const day = d ? String(d.getDate()).padStart(2, '0') : '-';
            const mon = d ? monthShortNames[d.getMonth()] : '';
            return `<div class="notice-item">
                <div class="notice-date"><span class="d">${day}</span><span class="m">${mon}</span></div>
                <div>
                    <div class="notice-title">${n.Title || ''}</div>
                    <div class="notice-meta">${n.Location || ''}</div>
                </div>
            </div>`;
        }).join('') : '<div class="text-muted small">No upcoming notices</div>';
    });
</script>
