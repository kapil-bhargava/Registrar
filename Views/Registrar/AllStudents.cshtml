    .asu-modal-box {
        background: #fff;
        border-radius: 14px;
        max-width: 520px;
        width: 92%;
        max-height: 85vh;
        overflow-y: auto;
    }

    .asu-modal-wide {
        max-width: 1000px;
    }

    .asu-modal-head {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 16px 20px;
        border-bottom: 1px solid #eef1f6;
    }

        .asu-modal-head button {
            border: none;
            background: none;
            font-size: 22px;
            cursor: pointer;
            color: #6B7A99;
        }

    .asu-modal-body {
        padding: 20px;
    }

    @@media (max-width: 900px) {
        .asu-stat-row {
            grid-template-columns: repeat(2,1fr);
        }

        .asu-filter-row {
            flex-direction: column;
            align-items: stretch;
        }

            .asu-filter-row .as-field,
            .asu-search-field {
                min-width: 0;
            }
    }
</style>

<script>
    let asuAllData = [];
    let asuCurrentQuickFilter = 'all';

    document.addEventListener('DOMContentLoaded', asuLoadData);

    // ---------------- Cascading Filters ----------------
function asuOnCourseChange() {
    const courseId = document.getElementById('fCourse').value;
    const branchSel = document.getElementById('fBranch');
    const semSel = document.getElementById('fSemester');

    branchSel.innerHTML = '<option value="">-- Select Course First --</option>';
    semSel.innerHTML = '<option value="">-- Select Branch First --</option>';
    branchSel.disabled = true;
    semSel.disabled = true;

    if (!courseId) { asuLoadData(); return; }

    branchSel.innerHTML = '<option value="">All Branches</option>';

    fetch('@Url.Action("GetBranchesByCourse", "AcademicSetup")?courseId=' + courseId)
        .then(res => res.json())
        .then(data => {
            data.forEach(b => {
                const opt = document.createElement('option');
                opt.value = b.BranchName;
                opt.textContent = b.BranchName;
                branchSel.appendChild(opt);
            });
            branchSel.disabled = false;
        });

    asuLoadData();
}

   function asuOnBranchChange() {
    const courseId = document.getElementById('fCourse').value;
    const semSel = document.getElementById('fSemester');

    semSel.innerHTML = '<option value="">-- Select Branch First --</option>';
    semSel.disabled = true;

    if (!courseId) { asuLoadData(); return; }

    semSel.innerHTML = '<option value="">All Semesters</option>';

    fetch('@Url.Action("GetSemesterNumbersByCourse", "AcademicSetup")?courseId=' + courseId)
        .then(res => res.json())
        .then(data => {
            data.forEach(s => {
                const opt = document.createElement('option');
                opt.value = s.SemesterNumber;
                opt.textContent = s.SemesterLabel;
                semSel.appendChild(opt);
            });
            semSel.disabled = false;
        });

    asuLoadData();
}

    function asuResetFilters() {
        document.getElementById('fCourse').value = '';
        document.getElementById('fBranch').innerHTML = '<option value="">-- Select Course First --</option>';
        document.getElementById('fBranch').disabled = true;
        document.getElementById('fSemester').innerHTML = '<option value="">-- Select Branch First --</option>';
        document.getElementById('fSemester').disabled = true;
        document.getElementById('fDocStatus').value = '';
        document.getElementById('fSearch').value = '';
        asuCurrentQuickFilter = 'all';
        asuSetActiveChip('all');
        asuLoadData();
    }

    // ---------------- Data Load ----------------

    function asuLoadData() {
        const courseId = document.getElementById('fCourse').value;
        const branch = document.getElementById('fBranch').value;
        const semester = document.getElementById('fSemester').value;
        const search = document.getElementById('fSearch').value;

        let url = '@Url.Action("GetAllStudentsOverviewJson", "Registrar")?';
        const params = [];
        if (courseId) params.push('courseId=' + courseId);
        if (branch) params.push('branch=' + encodeURIComponent(branch));
        if (semester) params.push('semester=' + encodeURIComponent(semester));
        if (search) params.push('search=' + encodeURIComponent(search));
        url += params.join('&');

        fetch(url)
            .then(res => res.json())
            .then(data => {
                asuAllData = data;
                asuRenderStats(data);
                asuApplyQuickFilterAndRender();
            });
    }

    function asuRenderStats(data) {
        const total = data.length;
        const docsPending = data.filter(d => d.DocumentStatus === 'Pending').length;
        const verifyPending = data.filter(d => d.VerificationStatus === 'Verification Pending').length;
        const deficient = data.filter(d => d.DocumentStatus === 'Deficient').length;
        const incomplete = data.filter(d => d.RegistrationStatus === 'Incomplete').length;
        const completed = data.filter(d => d.RegistrationStatus === 'Active').length;

        document.getElementById('statTotal').textContent = total;
        document.getElementById('statDocsPending').textContent = docsPending;
        document.getElementById('statVerifyPending').textContent = verifyPending;
        document.getElementById('statActionRequired').textContent = docsPending + deficient + incomplete;
        document.getElementById('statCompleted').textContent = completed;

        document.getElementById('actMissingDocs').textContent = docsPending;
        document.getElementById('actVerifyPending').textContent = verifyPending;
        document.getElementById('actDeficient').textContent = deficient;
        document.getElementById('actIncomplete').textContent = incomplete;
        document.getElementById('actCompleted').textContent = completed;
    }

    // ---------------- Quick Filters ----------------

    function asuQuickFilter(type) {
        asuCurrentQuickFilter = type;
        asuSetActiveChip(type);
        asuApplyQuickFilterAndRender();
    }

    function asuSetActiveChip(type) {
        document.querySelectorAll('.asu-chip').forEach(c => c.classList.remove('active'));
        const map = { all: 'chip-all', docsPending: 'chip-docsPending', verifyPending: 'chip-verifyPending', deficient: 'chip-deficient', completed: 'chip-completed' };
        const el = document.getElementById(map[type]);
        if (el) el.classList.add('active');
    }

    function asuApplyQuickFilterAndRender() {
        let filtered = asuAllData;
        switch (asuCurrentQuickFilter) {
            case 'docsPending': filtered = filtered.filter(d => d.DocumentStatus === 'Pending'); break;
            case 'verifyPending': filtered = filtered.filter(d => d.VerificationStatus === 'Verification Pending'); break;
            case 'deficient': filtered = filtered.filter(d => d.DocumentStatus === 'Deficient'); break;
            case 'incomplete': filtered = filtered.filter(d => d.RegistrationStatus === 'Incomplete'); break;
            case 'completed': filtered = filtered.filter(d => d.RegistrationStatus === 'Active'); break;
        }

        const docStatus = document.getElementById('fDocStatus').value;
        if (docStatus) {
            filtered = filtered.filter(d => d.DocumentStatus === docStatus);
        }

        asuRenderTable(filtered);
    }

    // ---------------- Table Render ----------------

    function asuRenderTable(data) {
        document.getElementById('recCount').textContent = data.length;
        const tbody = document.getElementById('asuTableBody');
        tbody.innerHTML = '';

        if (data.length === 0) {
            tbody.innerHTML = '<tr><td colspan="9" style="text-align:center; color:#6B7A99;">No students found</td></tr>';
            return;
        }

        data.forEach(s => {
            const pct = s.RequiredDocCount > 0 ? Math.round((s.SubmittedDocCount / s.RequiredDocCount) * 100) : 0;
            const barColor = pct >= 100 ? '#22C55E' : (pct >= 50 ? '#F2B705' : '#F04452');
            const initial = (s.FullName || '?').charAt(0).toUpperCase();
            const safeName = (s.FullName || '').replace(/'/g, "\\'");

            const docBadge = s.DocumentStatus === 'Complete'
                ? '<span class="as-pill as-pill-active"><i class="fas fa-circle"></i> Complete</span>'
                : s.DocumentStatus === 'Deficient'
                    ? '<span class="as-pill" style="background:#FFF1E3;color:#FF8A3D;"><i class="fas fa-circle"></i> Deficient</span>'
                    : '<span class="as-pill as-pill-draft"><i class="fas fa-circle"></i> Pending</span>';

            const verifyBadge = s.VerificationStatus === 'Verified'
                ? '<span class="as-pill as-pill-active"><i class="fas fa-circle"></i> Verified</span>'
                : '<span class="as-pill" style="background:#FFF8E1;color:#B8860B;"><i class="fas fa-circle"></i> Verification Pending</span>';

            const regBadge = s.RegistrationStatus === 'Active'
                ? '<span class="as-pill as-pill-active"><i class="fas fa-circle"></i> Active</span>'
                : '<span class="as-pill" style="background:#FEECEC;color:#F04452;"><i class="fas fa-circle"></i> Incomplete</span>';

            const enrollNo = s.RegistrationNumber || s.UniversityEnrollmentNumber || s.ApplicationNo;

            const row = document.createElement('tr');
            row.innerHTML =
                '<td><span class="asu-avatar">' + initial + '</span>' +
                    '<a href="javascript:void(0)" onclick="asuOpenProfile(' + s.ApplicationId + ')" style="color:#0B1B33;text-decoration:none;"><strong>' + s.FullName + '</strong></a></td>' +
                '<td>' + (enrollNo || '-') + '</td>' +
                '<td>' + s.CourseName + (s.Branch ? '<br><span class="as-hint">' + s.Branch + '</span>' : '') + '</td>' +
                '<td>' + (s.Semester || '-') + '</td>' +
                '<td style="cursor:pointer;" onclick="asuShowDocs(' + s.ApplicationId + ', \'' + safeName + '\')"><div class="asu-progress-wrap"><span class="asu-progress-text">' + s.SubmittedDocCount + '/' + s.RequiredDocCount + '</span>' +
                    '<div class="asu-progress-bar"><div class="asu-progress-fill" style="width:' + Math.min(pct, 100) + '%;background:' + barColor + ';"></div></div>' +
                    '<span class="asu-progress-text">' + pct + '%</span></div></td>' +
                '<td>' + docBadge + '</td>' +
                '<td>' + verifyBadge + '</td>' +
                '<td>' + regBadge + '</td>' +
                '<td>' +
                    '<a class="as-mini-btn" href="javascript:void(0)" title="View" onclick="asuOpenProfile(' + s.ApplicationId + ')"><i class="fas fa-eye"></i></a> ' +
                    '<a class="as-mini-btn" href="@Url.Action("PersonalInformation", "Admission")?applicationId=' + s.ApplicationId + '" title="Edit"><i class="fas fa-edit"></i></a>' +
                '</td>';
            tbody.appendChild(row);
        });
    }

    // ---------------- Required Docs Modal ----------------

    function asuShowDocs(applicationId, studentName) {
        document.getElementById('asuDocsModalTitle').textContent = studentName ? studentName + ' - Required Documents' : 'Required Documents';

        fetch('@Url.Action("GetSubmittedDocumentsJson", "Registrar")?applicationId=' + applicationId)
            .then(res => res.json())
            .then(data => {
                let html = data.length
                    ? '<table class="as-table"><thead><tr><th>#</th><th>Document</th><th>Status</th></tr></thead><tbody>' +
                        data.map((d, idx) =>
                            '<tr><td>' + (idx + 1) + '</td><td>' + d.DocumentName +
                            (d.IsMandatory ? ' <span style="color:#F04452;">*</span>' : '') + '</td><td>' +
                            (d.IsSubmitted
                                ? '<span class="as-pill as-pill-active"><i class="fas fa-circle"></i> Received</span>'
                                : '<span class="as-pill" style="background:#FEECEC;color:#F04452;"><i class="fas fa-circle"></i> Pending</span>') +
                            '</td></tr>'
                        ).join('') + '</tbody></table>'
                    : '<p class="as-hint">No documents mapped for this course.</p>';
                document.getElementById('asuDocsModalBody').innerHTML = html;
                document.getElementById('asuDocsModal').style.display = 'flex';
            });
    }
    function asuCloseDocsModal() { document.getElementById('asuDocsModal').style.display = 'none'; }

    // ---------------- Student Profile (Full Page) ----------------

    function asuOpenProfile(applicationId) {
        window.location.href = '@Url.Action("StudentProfile", "Registrar")/' + applicationId;
    }
</script>
