@{
    ViewBag.Title = "AllStudents";
    Layout = "~/Views/Shared/_mainLayout.cshtml";
}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<link href="~/Content/CSS/academicSession.css" rel="stylesheet" />

<div class="as-wrap">

    <!-- ================= TOP STAT CARDS ================= -->
    <div class="asu-stat-row">
        <div class="asu-stat-card">
            <div class="asu-stat-icon asu-blue"><i class="fas fa-user-graduate"></i></div>
            <div>
                <div class="asu-stat-label">TOTAL STUDENTS</div>
                <div class="asu-stat-number" id="statTotal">0</div>
                <div class="asu-stat-sub">All Registered Students</div>
            </div>
        </div>
        <div class="asu-stat-card">
            <div class="asu-stat-icon asu-orange"><i class="fas fa-file-alt"></i></div>
            <div>
                <div class="asu-stat-label">DOCUMENTS PENDING</div>
                <div class="asu-stat-number" id="statDocsPending">0</div>
                <div class="asu-stat-sub">Students with missing docs</div>
            </div>
        </div>
        <div class="asu-stat-card">
            <div class="asu-stat-icon asu-yellow"><i class="fas fa-clock"></i></div>
            <div>
                <div class="asu-stat-label">VERIFICATION PENDING</div>
                <div class="asu-stat-number" id="statVerifyPending">0</div>
                <div class="asu-stat-sub">Documents waiting to verify</div>
            </div>
        </div>
        <div class="asu-stat-card">
            <div class="asu-stat-icon asu-purple"><i class="fas fa-exclamation-circle"></i></div>
            <div>
                <div class="asu-stat-label">ACTION REQUIRED</div>
                <div class="asu-stat-number" id="statActionRequired">0</div>
                <div class="asu-stat-sub">Students need attention</div>
            </div>
        </div>
        <div class="asu-stat-card">
            <div class="asu-stat-icon asu-green"><i class="fas fa-check-circle"></i></div>
            <div>
                <div class="asu-stat-label">COMPLETED REGISTRATION</div>
                <div class="asu-stat-number" id="statCompleted">0</div>
                <div class="asu-stat-sub">Registration completed</div>
            </div>
        </div>
    </div>

    <!-- ================= ACTION CENTER ================= -->
    <div class="as-card">
        <div class="as-list-head">
            <div><h2><i class="fas fa-bolt"></i> Action Center</h2></div>
            <button class="as-btn as-btn-ghost as-btn-sm" onclick="asuLoadData()"><i class="fas fa-sync"></i> Refresh</button>
        </div>
        <div class="asu-action-row">
            <div class="asu-action-card asu-action-red">
                <div class="asu-action-num" id="actMissingDocs">0</div>
                <div class="asu-action-label">Missing Documents</div>
                <a href="javascript:void(0)" onclick="asuQuickFilter('docsPending')">View Students <i class="fas fa-arrow-right"></i></a>
            </div>
            <div class="asu-action-card asu-action-orange">
                <div class="asu-action-num" id="actVerifyPending">0</div>
                <div class="asu-action-label">Verification Pending</div>
                <a href="javascript:void(0)" onclick="asuQuickFilter('verifyPending')">View Students <i class="fas fa-arrow-right"></i></a>
            </div>
            <div class="asu-action-card asu-action-amber">
                <div class="asu-action-num" id="actDeficient">0</div>
                <div class="asu-action-label">Documents Deficient</div>
                <a href="javascript:void(0)" onclick="asuQuickFilter('deficient')">View Students <i class="fas fa-arrow-right"></i></a>
            </div>
            <div class="asu-action-card asu-action-blue">
                <div class="asu-action-num" id="actIncomplete">0</div>
                <div class="asu-action-label">Registration Incomplete</div>
                <a href="javascript:void(0)" onclick="asuQuickFilter('incomplete')">View Students <i class="fas fa-arrow-right"></i></a>
            </div>
            <div class="asu-action-card asu-action-green">
                <div class="asu-action-num" id="actCompleted">0</div>
                <div class="asu-action-label">Completed</div>
                <a href="javascript:void(0)" onclick="asuQuickFilter('completed')">View Students <i class="fas fa-arrow-right"></i></a>
            </div>
        </div>
    </div>

    <!-- ================= FILTERS ================= -->
    <div class="as-card">
        <p class="as-hint" style="margin-top:-4px;margin-bottom:14px;">Search and manage registered students. Data is shared with the Registrar Student List (Add/Edit) page.</p>

        <div class="asu-filter-row">
            <div class="as-field">
                <label>Course</label>
                <select id="fCourse" onchange="asuOnCourseChange()">
                    <option value="">All Courses</option>
                    @foreach (var c in ViewBag.Courses as List<Regis.Models.CourseMasterModel>)
                    {
                        <option value="@c.CourseId">@c.CourseName</option>
                    }
                </select>
            </div>
            <div class="as-field">
                <label>Branch</label>
                <select id="fBranch" onchange="asuOnBranchChange()" disabled>
                    <option value="">-- Select Course First --</option>
                </select>
            </div>
            <div class="as-field">
                <label>Semester</label>
                <select id="fSemester" disabled>
                    <option value="">-- Select Branch First --</option>
                </select>
            </div>
            <div class="as-field">
                <label>Document Status</label>
                <select id="fDocStatus" onchange="asuApplyQuickFilterAndRender()">
                    <option value="">All</option>
                    <option value="Complete">Complete</option>
                    <option value="Pending">Pending</option>
                    <option value="Deficient">Deficient</option>
                </select>
            </div>
            <div class="as-field asu-search-field">
                <label>Student Name</label>
                <div class="asu-search-box">
                    <input type="text" id="fSearch" placeholder="Search by Student Name, Email or Mobile" onkeypress="if(event.key==='Enter'){asuLoadData();}" />
                    <button class="asu-search-btn" onclick="asuLoadData()" title="Search"><i class="fas fa-search"></i></button>
                </div>
            </div>
            <button class="as-btn as-btn-ghost asu-reset-btn" onclick="asuResetFilters()">Reset</button>
        </div>

        <div class="asu-quick-filters">
            <button class="asu-chip active" onclick="asuQuickFilter('all')" id="chip-all">All Students</button>
            <button class="asu-chip" onclick="asuQuickFilter('docsPending')" id="chip-docsPending">Documents Pending</button>
            <button class="asu-chip" onclick="asuQuickFilter('verifyPending')" id="chip-verifyPending">Verification Pending</button>
            <button class="asu-chip" onclick="asuQuickFilter('deficient')" id="chip-deficient">Documents Deficient</button>
            <button class="asu-chip" onclick="asuQuickFilter('completed')" id="chip-completed">Completed</button>
        </div>
    </div>

    <!-- ================= TABLE ================= -->
    <div class="as-card">
        <div class="as-list-head">
            <div><h2><i class="fas fa-list"></i> Student Records (<span id="recCount">0</span>)</h2></div>
        </div>
        <div class="as-table-wrapper">
            <table class="as-table as-list-table">
                <thead>
                    <tr>
                        <th>Student</th>
                        <th>Enrollment / Roll No.</th>
                        <th>Program / Branch</th>
                        <th>Semester</th>
                        <th>Required Docs</th>
                        <th>Document Status</th>
                        <th>Verification Status</th>
                        <th>Registration Status</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody id="asuTableBody">
                    <tr><td colspan="9" style="text-align:center; color:#6B7A99;">Loading...</td></tr>
                </tbody>
            </table>
        </div>
    </div>

    <!-- ================= SUBMITTED DOCS MODAL ================= -->
    <div class="asu-modal-overlay" id="asuDocsModal" style="display:none;">
        <div class="asu-modal-box">
            <div class="asu-modal-head">
                <h3 id="asuDocsModalTitle">Required Documents</h3>
                <button onclick="asuCloseDocsModal()">&times;</button>
            </div>
            <div class="asu-modal-body" id="asuDocsModalBody"></div>
        </div>
    </div>

    <!-- ================= STUDENT PROFILE MODAL ================= -->
    <div class="asu-modal-overlay" id="asuProfileModal" style="display:none;">
        <div class="asu-modal-box asu-modal-wide">
            <div class="asu-modal-body" id="asuProfileModalBody"></div>
        </div>
    </div>

</div>

<style>
    .asu-stat-row {
        display: grid;
        grid-template-columns: repeat(5,1fr);
        gap: 12px;
        margin-bottom: 16px;
    }

    .asu-stat-card {
        background: #fff;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        padding: 11px 13px;
        display: flex;
        gap: 10px;
        align-items: center;
    }

    .asu-stat-icon {
        width: 34px;
        height: 34px;
        border-radius: 9px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 13px;
        color: #fff;
        flex-shrink: 0;
    }

    .asu-blue {
        background: #3B5BFE;
    }

    .asu-orange {
        background: #FF8A3D;
    }

    .asu-yellow {
        background: #F2B705;
    }

    .asu-purple {
        background: #8B5CF6;
    }

    .asu-green {
        background: #22C55E;
    }

    .asu-stat-label {
        font-size: 10px;
        font-weight: 700;
        color: #8A93A6;
        letter-spacing: .3px;
    }

    .asu-stat-number {
        font-size: 20px;
        font-weight: 700;
        color: #0B1B33;
        line-height: 1.25;
    }

    .asu-stat-sub {
        font-size: 11px;
        color: #8A93A6;
    }

    .asu-action-row {
        display: grid;
        grid-template-columns: repeat(5,1fr);
        gap: 12px;
    }

    .asu-action-card {
        border-radius: 12px;
        padding: 14px;
    }

    .asu-action-red {
        background: #FEECEC;
    }

    .asu-action-orange {
        background: #FFF1E3;
    }

    .asu-action-amber {
        background: #FFF8E1;
    }

    .asu-action-blue {
        background: #E9F0FF;
    }

    .asu-action-green {
        background: #E8F9EE;
    }

    .asu-action-num {
        font-size: 24px;
        font-weight: 700;
        color: #0B1B33;
    }

    .asu-action-label {
        font-size: 12.5px;
        color: #4B5768;
        margin: 4px 0 8px;
    }

    .asu-action-card a {
        font-size: 12.5px;
        font-weight: 600;
        color: #3B5BFE;
        text-decoration: none;
    }

    /* ---------------- Compact Filter Row ---------------- */

    .asu-filter-row {
        display: flex;
        align-items: flex-end;
        gap: 12px;
        flex-wrap: wrap;
    }

        .asu-filter-row .as-field {
            flex: 1;
            min-width: 130px;
            margin-bottom: 0;
        }

            .asu-filter-row .as-field label {
                display: block;
                font-size: 10.5px;
                font-weight: 700;
                color: #8A93A6;
                letter-spacing: .3px;
                text-transform: uppercase;
                margin-bottom: 5px;
            }

        .asu-filter-row select,
        .asu-filter-row input[type="text"] {
            width: 100%;
            height: 36px;
            padding: 0 10px;
            border: 1px solid #e2e8f0;
            border-radius: 8px;
            font-size: 13px;
            color: #4B5768;
            background: #fff;
            box-sizing: border-box;
        }

            .asu-filter-row select:disabled {
                color: #B7C0CE;
                background: #FAFBFD;
            }

    .asu-search-field {
        flex: 1.7;
        min-width: 210px;
    }

    .asu-search-box {
        display: flex;
        gap: 8px;
    }

        .asu-search-box input {
            flex: 1;
        }

    .asu-search-btn {
        width: 36px;
        height: 36px;
        border-radius: 8px;
        border: none;
        background: #0B1B33;
        color: #fff;
        cursor: pointer;
        flex-shrink: 0;
        font-size: 13px;
    }

        .asu-search-btn:hover {
            background: #16294A;
        }

    .asu-reset-btn {
        height: 36px;
        padding: 0 16px;
        border-radius: 8px;
        font-size: 13px;
        white-space: nowrap;
    }

    .asu-quick-filters {
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
        margin-top: 14px;
    }

    .asu-chip {
        border: 1px solid #e2e8f0;
        background: #fff;
        color: #4B5768;
        border-radius: 20px;
        padding: 6px 14px;
