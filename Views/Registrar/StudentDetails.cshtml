@model Regis.Models.RegistrarStudentModel

@{
    ViewBag.Title = "StudentDetails";
    Layout = "~/Views/Shared/_mainLayout.cshtml";
}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<link href="~/Content/CSS/academicSession.css" rel="stylesheet" />

@if (TempData["Error"] != null)
{
    <div style="background:#fee; color:#900; padding:10px; margin:10px 0; border:1px solid #900;">@TempData["Error"]</div>
}

<div class="as-wrap">

    <div class="as-back-row">
        <a class="as-back-link" href="@Url.Action("RegistrarStudentList", "Registrar")">
            <i class="fas fa-arrow-left"></i> Back to Student List
        </a>
    </div>

    <!-- ================= 2x2 DASHBOARD GRID ================= -->
    <div class="sd-grid">
        @Html.Partial("_StudentInfoPartial", Model)
        @Html.Partial("_FeeInfoPartial", Model)
        @Html.Partial("_FeeStructurePartial", Model)
        @Html.Partial("_DocumentListPartial", Model)
    </div>

    <div class="as-bar" style="border-top:none; padding-top:0;">
        <a class="as-btn as-btn-primary" href="@Url.Action("RegistrarStudentList", "Registrar")" onclick="sessionStorage.setItem('editStudentId', @Model.RegistrarId);">
            <i class="fas fa-edit"></i> Edit This Student
        </a>
    </div>

</div>

<style>
    /* ============================================================
       2x2 dashboard grid — Student Info | Fee Info
                            Fee Structure | List of Documents
       ============================================================ */
    .sd-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        grid-auto-rows: 1fr;
        gap: 18px;
        align-items: stretch;
    }

    .sd-panel {
        margin: 0;
        height: 100%;
        display: flex;
        flex-direction: column;
    }

    @@media (max-width: 900px) {
        .sd-grid {
            grid-template-columns: 1fr;
            grid-auto-rows: auto;
        }

        .sd-panel {
            height: auto;
        }
    }

    /* ---- shared panel header ---- */
    .sd-info-head {
        display: flex;
        align-items: baseline;
        gap: 8px;
        font-size: 0.92rem;
        font-weight: 700;
        color: #0A4E95;
        padding-bottom: 0.7rem;
        margin-bottom: 0.6rem;
        border-bottom: 1px solid #eef1f5;
    }

        .sd-info-head i {
            font-size: 0.8rem;
            align-self: center;
        }

        .sd-info-head .sd-info-id {
            font-weight: 500;
            color: #9aa3af;
            font-size: 0.78rem;
        }

    .sd-status-pill {
        font-size: 0.7rem;
        padding: 0.22rem 0.6rem;
        vertical-align: middle;
    }

    .sd-info-lines {
        display: flex;
        flex-direction: column;
        gap: 0.4rem;
    }

    .sd-info-line {
        font-size: 0.82rem;
        color: #1f2937;
        line-height: 1.5;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .sd-info-k {
        color: #6b7280;
        margin-right: 4px;
    }

    .sd-meta-link {
        color: #0A4E95;
        text-decoration: none;
    }

        .sd-meta-link:hover {
            text-decoration: underline;
        }

    /* ---- Fee Info panel sub-sections ---- */
    .sd-sub-head {
        display: flex;
        align-items: center;
        gap: 6px;
        font-size: 0.82rem;
        font-weight: 700;
        color: #0A4E95;
        margin: 0.9rem 0 0.4rem;
    }

    .sd-not-available {
        color: #9aa3af;
        font-style: italic;
        font-size: 0.8rem;
    }

    .sd-edit-link {
        color: #94a3b8;
        margin-left: 6px;
        font-size: 0.72rem;
    }

    /* ---- mini tables (Fee Structure / List of Documents) ---- */
    .sd-feestruct-sub {
        font-size: 0.75rem;
        color: #9aa3af;
        margin-bottom: 0.6rem;
    }

    .sd-table-wrap {
        overflow-x: auto;
        flex: 1;
    }

    .sd-doclist-scroll {
        max-height: 320px;
        overflow-y: auto;
        flex: 1;
    }

    .sd-mini-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 0.78rem;
    }

        .sd-mini-table thead th {
            background: #16305c;
            color: #fff;
            text-align: left;
            padding: 8px 10px;
            font-weight: 700;
            white-space: nowrap;
            position: sticky;
            top: 0;
        }

        .sd-mini-table tbody td {
            padding: 8px 10px;
            border-bottom: 1px solid #f1f3f8;
            color: #1f2937;
        }

        .sd-mini-table tbody tr:hover {
            background: #f9fafb;
        }

    .sd-empty-row {
        text-align: center;//
        color: #9aa3af;
        padding: 18px 10px !important;
        font-size: 0.8rem;
    }

    .sd-mini-table tbody td.sd-status-uploaded {
        color: #16a34a;
        font-weight: 600;
    }

    .sd-mini-table tbody td.sd-status-notuploaded {
        color: #dc2626;
        font-weight: 600;
    }

    .sd-mini-table tbody td.sd-received-yes {
        color: #16a34a;
        font-weight: 600;
    }

    .sd-mini-table tbody td.sd-received-no {
        color: #dc2626;
        font-weight: 600;
    }
</style>
